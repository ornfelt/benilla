in 0 vec3 position
in 1 vec2 uv
in 2 vec4 color

out 0 vec2 uv
out 1 vec4 color

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
}

// Bevy's clip z, in [0, 1], into [-1, 1] where the device clips depth there (`misc.y` 2 or 3: a
// GL without clip control), as naga's GL writer does.
vec4 device_clip(vec4 clip)
{
	if (misc.y > 1.5)
		clip.z = 2.0 * clip.z - clip.w;
	return clip;
}

// The vertex stage of `benilla-world/src/shaders/sky_vertex.wgsl` under `cloud.wgsl`: bevy's
// mesh vertex with clip z pinned to the far plane (reverse-Z 0, `SKY_FAR_CLIP_Z`), so a sky
// fragment passes only where the depth buffer still holds its clear.
vs_output gfx_main(vs_input gfx_input)
{
	vs_output gfx_output;
	vec4 world = mul(vec4(gfx_input.position, 1.0), world_from_local);
	vec4 clip = mul(world, clip_from_world);
	clip.z = 0.0;
	gfx_output.gfx_position = device_clip(clip);
	gfx_output.uv = gfx_input.uv;
	gfx_output.color = gfx_input.color;
	return gfx_output;
}
