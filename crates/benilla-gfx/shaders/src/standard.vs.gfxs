in 0 vec3 position
in 1 vec3 normal
in 2 vec2 uv
in 3 vec4 color

out 0 vec2 uv
out 1 vec4 color
out 2 vec3 world_normal
out 3 vec3 world_pos

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
	vec4 ambient
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 base_color
	vec4 uv_matrix
	vec4 uv_offset_cutoff_mode
	vec4 flags
	vec4 reflectance
	vec4 emissive
}

// `mesh_normal_local_to_world`: the inverse transpose of the world matrix's 3x3, through the
// adjugate, a zero normal left as is.
vec3 normal_to_world(vec3 n)
{
	vec3 c0 = world_from_local[0].xyz;
	vec3 c1 = world_from_local[1].xyz;
	vec3 c2 = world_from_local[2].xyz;
	if (n.x == 0.0 && n.y == 0.0 && n.z == 0.0)
		return n;
	vec3 x = cross(c1, c2);
	vec3 y = cross(c2, c0);
	vec3 z = cross(c0, c1);
	float det = dot(c2, z);
	return normalize((x * n.x + y * n.y + z * n.z) / det);
}

// Bevy's clip z, in [0, 1], into [-1, 1] where the device clips depth there (`misc.y` 2 or 3: a
// GL without clip control), as naga's GL writer does.
vec4 device_clip(vec4 clip)
{
	if (misc.y > 1.5)
		clip.z = 2.0 * clip.z - clip.w;
	return clip;
}

vs_output gfx_main(vs_input gfx_input)
{
	vs_output gfx_output;
	vec4 world = mul(vec4(gfx_input.position, 1.0), world_from_local);
	gfx_output.gfx_position = device_clip(mul(world, clip_from_world));
	vec2 uv = gfx_input.uv;
	gfx_output.uv = vec2(uv_matrix.x * uv.x + uv_matrix.z * uv.y, uv_matrix.y * uv.x + uv_matrix.w * uv.y) + uv_offset_cutoff_mode.xy;
	gfx_output.color = gfx_input.color;
	gfx_output.world_normal = normal_to_world(gfx_input.normal);
	gfx_output.world_pos = world.xyz;
	return gfx_output;
}
