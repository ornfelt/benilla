in 0 vec2 uv
in 1 vec4 color
in 2 float view_z

out 0 vec4 color

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 fog
	vec4 mode
	vec4 clip
}

sampler 0 2d effect_texture
sampler 1 2d_array wow_light

// The fragment stage of `benilla-world/src/shaders/wow_effect.wgsl`, line for line: texture bytes
// times the authored gamma vertex colour, the alpha key, the scene light against world up, the
// per-blend fog colour and rain's forced fog, and the output each blend expects. `fog` is the
// WGSL's `wow_params.fog`; `mode.x` the blend (0 add, 1 alpha, 2 opaque, 3 alpha key, 4 multiply,
// 5 mod2x, the WGSL's `BLEND_*` defs), `mode.y` `EFFECT_LIT`, `mode.z` `DECAL_WORLD_CLIP`, `mode.w`
// the `$WOW_PARTICLE_FLAT` instrument; `clip` the WGSL's `wow_params.clip`, the target rect in
// pixels (min.xy, max.xy), none when z <= x.

// The rain pass's forced fog colour: 0x80808080 -> grey (render-state 0x0d).
#define RAIN_FOG_GREY 0.50196078

vec4 light_row(int i)
{
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(wow_light, ivec3(r & 255, r >> 8, layer), 0);
#else
	return wow_light.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

vec4 effect_bias(vec2 uv, float bias)
{
#ifdef GFX_GLSL
	return texture(effect_texture, uv, bias);
#else
	return effect_texture.SampleBias(effect_texture_sampler, uv, bias);
#endif
}

fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
	// `$WOW_PARTICLE_FLAT` debug instrument: solid magenta, no inputs.
	if (mode.w > 0.5)
	{
		gfx_output.color = vec4(1.0, 0.0, 1.0, 1.0);
		return gfx_output;
	}
	float vz = gfx_input.view_z;
	// The target-rect clip on the framebuffer pixel, top-down: GL's fragment rows count bottom-up,
	// but for a target drawn top-down (`misc.y` 2).
	if (clip.z > clip.x)
	{
		vec2 p = gfx_input.gfx_position.xy;
		if (misc.y > 0.5 && misc.y < 1.5)
			p.y = misc.z - p.y;
		if (p.x < clip.x || p.y < clip.y || p.x > clip.z || p.y > clip.w)
			discard;
	}
	// The hard far-clip wall (the live `farclip`): every world shader discards past it.
	vec4 fog_params = light_row(5);
	if (fog_params.w > 0.0 && vz > fog_params.w)
		discard;
	// Texture bytes x authored vertex colour in gamma space, at the view's mip bias.
	vec4 c = effect_bias(gfx_input.uv, misc.x) * gfx_input.color;
	float blend = mode.x;
	// The fixed-function alpha test (EGxRs id 0x08): GEQUAL 224/255.
	if (blend > 2.5 && blend < 3.5 && c.w < 224.0 / 255.0)
		discard;
	vec3 rgb = c.xyz;
	if (mode.y > 0.5)
	{
		// Scene lighting with N = world up for the whole draw (`0x70d8b0`).
		vec3 l = -normalize(light_row(2).xyz);
		vec3 lit = clamp(light_row(0).xyz + light_row(1).xyz * max(l.y, 0.0), vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
		rgb = rgb * lit;
	}
	// Scene fog: the world's linear fog in gamma space; only its colour follows the blend's
	// policy in `fog.x` (0 off, 1 scene, 2 black, 3 white, 4 grey).
	vec4 fog_color = light_row(4);
	if (fog_color.w > 0.5 && fog.x > 0.5)
	{
		float denom = max(fog_params.y - fog_params.x, 0.001);
		float factor = clamp((fog_params.y - vz) / denom, 0.0, 1.0);
		vec3 fog_rgb = fog_color.xyz;
		if (fog.x > 1.5 && fog.x < 2.5)
			fog_rgb = vec3(0.0, 0.0, 0.0);
		else if (fog.x > 2.5 && fog.x < 3.5)
			fog_rgb = vec3(1.0, 1.0, 1.0);
		else if (fog.x > 3.5)
			fog_rgb = vec3(RAIN_FOG_GREY, RAIN_FOG_GREY, RAIN_FOG_GREY);
		rgb = mix(fog_rgb, rgb, factor);
	}
	// Rain's forced fog: grey over the draw's own start and end.
	if (fog.y > 0.5)
	{
		float denom = max(fog.w - fog.z, 0.001);
		float factor = clamp((fog.w - vz) / denom, 0.0, 1.0);
		rgb = mix(vec3(RAIN_FOG_GREY, RAIN_FOG_GREY, RAIN_FOG_GREY), rgb, factor);
	}
	if (blend < 0.5)
		gfx_output.color = vec4(rgb * c.w, 0.0);
	else if (blend < 1.5)
		gfx_output.color = vec4(rgb, c.w);
	else if (blend < 4.5 && blend > 3.5)
		gfx_output.color = vec4(rgb * c.w, c.w);
	else
		// Opaque, alpha key (blending off) and mod2x (reads no alpha).
		gfx_output.color = vec4(rgb, 1.0);
	return gfx_output;
}
