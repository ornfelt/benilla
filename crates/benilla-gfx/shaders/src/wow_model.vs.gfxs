in 0 vec3 position
in 1 vec3 normal
in 2 vec2 uv
in 3 vec4 color
in 4 uvec4 joint_indices
in 5 vec4 joint_weights
in 6 vec4 fade_sphere
in 7 int merged_slot
in 8 vec2 uv_b

out 0 vec4 world_position
out 1 vec3 world_normal
out 2 vec2 uv
out 3 vec4 color
out 4 vec3 primary
out 5 float merged_fade
out 6 vec2 stage1_uv

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 base_color
	vec4 uv_matrix
	vec4 uv_offset_cutoff_mode
	vec4 flags
	vec4 clutter_fade
	vec4 model_flags
	vec4 sun_scale
	vec4 tint
	vec4 sidn
	vec4 anim_slots
	vec4 stage1
	vec4 stage1_uv
}

// The vertex stage of `benilla-assets/src/shaders/wow_model.wgsl` (the M2, WMO and clutter pass),
// line for line. Bevy's shader defs are runtime tests here: `tag.y` has bit `i` for program input
// `i` the mesh has (4 = `WOW_RIG_SKIN`, 6 = `WOW_MERGED_FADE`, 7 = `WOW_MERGED_SLOT`, 8 =
// `VERTEX_UVS_B`).

// The shared light buffer as a data texture (`benilla-gfx/src/data.rs`), declared here by hand:
// the compiler prints samplers in the fragment stage only. Same slot as the fragment stage's.
#ifdef GFX_GLSL
#if defined(GFX_VK)
layout(set = 1, binding = 1) uniform sampler2DArray wow_light;
#elif defined(GFX_GL3)
uniform sampler2DArray wow_light;
#else
layout(binding = 1) uniform sampler2DArray wow_light;
#endif
#else
Texture2DArray wow_light : register(t1);
#endif

// Row bases of the `wow_light` regions, row = byte offset / 16 of the wgpu buffer (in sync with
// `benilla-world/src/gfx/light.rs`, whose test reads these lines).
#define WOW_POINTS_BASE 21
#define WOW_PROBES_BASE 533
#define WOW_RIG_TABLE_BASE 57877
#define WOW_RIG_TINT_BASE 58389
#define WOW_RIG_ORIGIN_BASE 58901
#define WOW_MATANIM_BASE 60949
#define WOW_PALETTE_BASE 64021

vec4 light_row(int i)
{
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(wow_light, ivec3(r & 255, r >> 8, layer), 0);
#else
	return wow_light.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

// Zero-safe normalize (`wow_normalize`): an authored (0,0,0) normal lights by the SH DC term.
vec3 wow_normalize(vec3 v)
{
	float l2 = dot(v, v);
	return l2 > 1e-12 ? normalize(v) : vec3(0.0, 0.0, 0.0);
}

vec3 clamp01(vec3 v)
{
	return clamp(v, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
}

// The <=3 point lights nearest `anchor` (`point_light_sum`): range bounds candidacy only, a
// selected light falls off as 1/(0.7 d + 0.03 d^2), diffuse on the submitted normal. `.w` is how
// many are bound.
vec4 point_light_sum(vec3 P, vec3 N, vec3 anchor)
{
	// At most the 256 lights the table holds (512 rows): a count read off a wrong binding must
	// not spin the GPU into a reset.
	int count = min(int(light_row(20).x), 256);
	int sel0 = 0;
	int sel1 = 0;
	int sel2 = 0;
	float sd0 = 1e30;
	float sd1 = 1e30;
	float sd2 = 1e30;
	for (int i = 0; i < count; i++)
	{
		vec4 pos_range = light_row(WOW_POINTS_BASE + 2 * i);
		vec3 dv = pos_range.xyz - anchor;
		float d2 = dot(dv, dv);
		if (d2 > pos_range.w * pos_range.w)
			continue;
		if (d2 < sd0)
		{
			sd2 = sd1; sel2 = sel1;
			sd1 = sd0; sel1 = sel0;
			sd0 = d2; sel0 = i;
		}
		else if (d2 < sd1)
		{
			sd2 = sd1; sel2 = sel1;
			sd1 = d2; sel1 = i;
		}
		else if (d2 < sd2)
		{
			sd2 = d2; sel2 = i;
		}
	}
	vec4 sum = vec4(0.0, 0.0, 0.0, 0.0);
	for (int s = 0; s < 3; s++)
	{
		float sd = s == 0 ? sd0 : (s == 1 ? sd1 : sd2);
		int sel = s == 0 ? sel0 : (s == 1 ? sel1 : sel2);
		if (sd > 9.9e29)
			break;
		vec4 pos_range = light_row(WOW_POINTS_BASE + 2 * sel);
		vec3 to_light = pos_range.xyz - P;
		float d = length(to_light);
		float atten = 1.0 / (0.7 * d + 0.03 * d * d);
		float nl = max(dot(N, to_light / max(d, 1e-4)), 0.0);
		sum += vec4(light_row(WOW_POINTS_BASE + 2 * sel + 1).rgb * (atten * nl), 1.0);
	}
	return sum;
}

// The body tint by the tag's rig slot (`body_tint`; `rig_tint` packed as rgb24 floats with -1 the
// identity): the material colour, multiplying the light sum inside the clamp.
vec3 body_tint(uint fade_tag)
{
	int rig_slot = int((fade_tag >> 19u) & 0x7ffu);
	vec4 tint_row = light_row(WOW_RIG_TINT_BASE + (rig_slot >> 2));
	int tint_lane = rig_slot & 3;
	float tint_word = tint_lane == 0 ? tint_row.x : (tint_lane == 1 ? tint_row.y : (tint_lane == 2 ? tint_row.z : tint_row.w));
	if (tint_word < 0.0)
		return vec3(1.0, 1.0, 1.0);
	uint word = uint(tint_word);
	return vec3(float((word >> 16u) & 0xffu), float((word >> 8u) & 0xffu), float(word & 0xffu)) * (1.0 / 255.0);
}

// The lit colour at one vertex (`vertex_light`): the reference lights in the vertex stage and the
// rasterizer interpolates the clamped result. `vcol` is the vertex colour (white without one),
// `point_lit` the bound point lights' sum and, in `.w`, their count. The colour is the lit
// material, inside the one clamp.
vec3 vertex_light(vec3 world_normal, vec4 point_lit, vec4 vcol, int probe_slot, uint raw_tag)
{
	vec4 light_ambient = light_row(0);
	vec4 light_diffuse = light_row(1);
	vec4 light_sun = light_row(2);
	vec4 grade = light_row(17);
	bool is_clutter = clutter_fade.w > 0.5;
	bool is_wmo = model_flags.x > 0.5;
	bool is_interior = model_flags.z > 0.5;
	bool interior_prop = is_interior && !is_wmo;
	uint fade_tag = raw_tag & 0x3fffffffu;
	// The hover/target highlight (tag bit 31): the scene ambient, inside the final clamp.
	vec3 highlight = (raw_tag & 0x80000000u) != 0u ? light_ambient.rgb : vec3(0.0, 0.0, 0.0);
	vec3 L = -normalize(light_sun.xyz);
	vec3 n_lit = wow_normalize(world_normal);
	float ndotl = max(dot(n_lit, L), 0.0);
	// The FFP light sum, unclamped: GL clamps the lit colour once, after the material colour.
	vec3 sum_nl = light_ambient.rgb + light_diffuse.rgb * ndotl;
	if (is_wmo)
	{
		// WMO interior groups by batch class (`tint.w`): INT (1) unlit, TRANS (2) this the lit
		// pass, EXT (0) the FFP sum. A WINDOW batch on the interior drawer lights with the
		// Direct/Ambient midpoint, its +16/255 ambient saturating on its own.
		vec3 window_mid = 0.5 * (light_ambient.rgb + light_diffuse.rgb);
		vec3 sum_window = min(window_mid + vec3(16.0 / 255.0, 16.0 / 255.0, 16.0 / 255.0), vec3(1.0, 1.0, 1.0)) + window_mid * ndotl;
		vec3 sum_wmo = sum_nl;
		// SIDN night glow: an emission term beside MOCV inside the clamp.
		float sidn_w = 1.0;
		if (is_interior)
		{
			sum_wmo = sidn.w > 0.5 ? sum_window : sum_nl;
			if (tint.w > 0.5 && tint.w < 1.5)
			{
				sum_wmo = vec3(1.0, 1.0, 1.0);
				sidn_w = 0.0;
			}
		}
		vec3 sidn_e = sidn.rgb * (grade.x * sidn_w);
		return clamp01(vcol.rgb * sum_wmo + sidn_e + highlight);
	}
	// `c28`: the vertex colour x the animated M2Color x the body tint.
	vec3 anim_tint = tint.rgb + light_row(WOW_MATANIM_BASE + int(anim_slots.y)).xyz;
	vec3 c = vcol.rgb * anim_tint * body_tint(fade_tag);
	if (is_clutter)
		// The detail-doodad pass lights by the FFP: the grey multiplies the whole sum.
		return clamp01(c * (sum_nl + point_lit.rgb) + highlight);
	vec4 quad = vec4(n_lit.x * n_lit.y, n_lit.y * n_lit.z, n_lit.z * n_lit.z, n_lit.x * n_lit.z);
	vec4 n1 = vec4(n_lit, 1.0);
	float x2y2 = n_lit.x * n_lit.x - n_lit.y * n_lit.y;
	// The `Model2.bls` lobe at the per-instance intensity (see the WGSL for the families), baked
	// into the SH unclamped; only the per-vertex sum clamps.
	float inst_shade = interior_prop ? 0.0 : float((fade_tag >> 6u) & 0xffu) / 255.0;
	float mat_shade = sun_scale.x < 0.5 ? 1.0 : 0.0;
	float shade_t = max(mat_shade, inst_shade);
	bool mid_band = sun_scale.x >= 0.5 && sun_scale.x < 0.85;
	float intensity = mid_band ? 1.0 : mix(2.5, 0.5, shade_t);
	vec3 sun_dc = grade.yzw * intensity;
	vec4 sh_c10_r = light_row(6);
	vec4 sh_c10_g = light_row(7);
	vec4 sh_c10_b = light_row(8);
	vec4 sh_c16 = light_row(12);
	vec3 sun_lobe = vec3(
		sh_c10_r.w + sun_dc.x + intensity * (dot(sh_c10_r.xyz, n_lit) + dot(light_row(9), quad) + sh_c16.x * x2y2),
		sh_c10_g.w + sun_dc.y + intensity * (dot(sh_c10_g.xyz, n_lit) + dot(light_row(10), quad) + sh_c16.y * x2y2),
		sh_c10_b.w + sun_dc.z + intensity * (dot(sh_c10_b.xyz, n_lit) + dot(light_row(11), quad) + sh_c16.z * x2y2));
	// Interior M2 props: the prop's order-2 SH probe (7 rows a slot).
	int probe = WOW_PROBES_BASE + 7 * probe_slot;
	vec4 p6 = light_row(probe + 6);
	vec3 e_probe = vec3(
		dot(light_row(probe), n1) + dot(light_row(probe + 3), quad) + p6.x * x2y2,
		dot(light_row(probe + 1), n1) + dot(light_row(probe + 4), quad) + p6.y * x2y2,
		dot(light_row(probe + 2), n1) + dot(light_row(probe + 5), quad) + p6.z * x2y2);
	// The lobe needs the directional light on (`light_sun.w`); off, the FFP sum stands in.
	vec3 e_exterior = light_sun.w > 0.5 ? sun_lobe : sum_nl;
	bool is_rig = sun_scale.x >= 1.5;
	vec3 e = ((is_interior || is_rig) ? e_probe : e_exterior) + point_lit.rgb;
	// `Model2.bls`: with a point light bound E clamps to [0, 1] first.
	if (point_lit.w > 0.5)
		e = clamp01(e);
	return clamp01(c * e + highlight);
}

// The centre of the MCNK chunk under P (`mcnk_cell_anchor`), world-merged clutter's light anchor.
vec3 mcnk_cell_anchor(vec3 P)
{
	float cell = 533.33333 / 16.0;
	float half_extent = 32.0 * 533.33333;
	float ix = floor((half_extent + P.x) / cell);
	float iz = floor((half_extent + P.z) / cell);
	return vec3((ix + 0.5) * cell - half_extent, P.y, (iz + 0.5) * cell - half_extent);
}

// The doodad fade curve (`merged_fade_alpha`, `0x683f80`).
float merged_fade_alpha(float radius, float horiz_dist)
{
	if (radius > 7.0)
		return 1.0;
	float start = 150.0;
	float range = 50.0;
	if (radius <= 0.5)
	{
		start = 40.0;
		range = 10.0;
	}
	else if (radius <= 2.5)
	{
		start = 100.0;
		range = 25.0;
	}
	float d = horiz_dist - radius;
	return clamp(1.0 - (d - start) / range, 0.0, 1.0);
}

// `c0 * v.x + c1 * v.y + c2 * v.z`: a 3x3 by its columns times v.
vec3 cols3(vec3 c0, vec3 c1, vec3 c2, vec3 v)
{
	return c0 * v.x + c1 * v.y + c2 * v.z;
}

// bevy_pbr::skinning's inverse-transpose via the adjugate, of the 3x3 with columns c0, c1, c2,
// applied to n.
vec3 inverse_transpose_apply(vec3 c0, vec3 c1, vec3 c2, vec3 n)
{
	vec3 x = cross(c1, c2);
	vec3 y = cross(c2, c0);
	vec3 z = cross(c0, c1);
	float det = dot(c2, z);
	return cols3(x / det, y / det, z / det, n);
}

// Bevy's clip z, in [0, 1], into [-1, 1] where the device clips depth there (`misc.y` 2 or 3: a
// GL without clip control), as naga's GL writer does.
vec4 device_clip(vec4 clip)
{
	if (misc.y > 1.5)
		clip.z = 2.0 * clip.z - clip.w;
	return clip;
}

// The generated environment coordinate of `Model2.bls`: in view space R = normalize(P - 2(P.N)N),
// uv = R.xy 0.5 + 0.5, per vertex.
vec2 wow_env_uv(vec3 p_view, vec3 n_view)
{
	vec3 refl = normalize(p_view - 2.0 * dot(p_view, n_view) * n_view);
	return refl.xy * 0.5 + vec2(0.5, 0.5);
}

vs_output gfx_main(vs_input gfx_input)
{
	vs_output gfx_output;
	uint present = tag.y;
	bool skin = (present & 16u) != 0u;
	bool merged_fade_on = (present & 64u) != 0u;
	bool merged_slot_on = merged_fade_on && (present & 128u) != 0u;
	uint markers = uint(clutter_fade.z);

	// Precision: the frame holds the orientation, `frame_origin` the ~9 k yd world position, so no
	// f32 product mixes the two.
	vec3 c0 = world_from_local[0].xyz;
	vec3 c1 = world_from_local[1].xyz;
	vec3 c2 = world_from_local[2].xyz;
	vec3 frame_origin = world_from_local[3].xyz;
	vec3 frame_t = vec3(0.0, 0.0, 0.0);
	if (skin)
	{
		// `wow_skin_model`: the four weighted bones' palette rows blended into `rig_from_local`,
		// relative to `rig_origin[slot]`.
		int slot = int((tag.x >> 19u) & 0x7ffu);
		vec4 table = light_row(WOW_RIG_TABLE_BASE + (slot >> 2));
		int lane = slot & 3;
		int base = int(lane == 0 ? table.x : (lane == 1 ? table.y : (lane == 2 ? table.z : table.w)));
		uvec4 ji = gfx_input.joint_indices;
		vec4 w = gfx_input.joint_weights;
		int b0 = WOW_PALETTE_BASE + 3 * (base + int(ji.x));
		int b1 = WOW_PALETTE_BASE + 3 * (base + int(ji.y));
		int b2 = WOW_PALETTE_BASE + 3 * (base + int(ji.z));
		int b3 = WOW_PALETTE_BASE + 3 * (base + int(ji.w));
		vec4 r0 = w.x * light_row(b0) + w.y * light_row(b1) + w.z * light_row(b2) + w.w * light_row(b3);
		vec4 r1 = w.x * light_row(b0 + 1) + w.y * light_row(b1 + 1) + w.z * light_row(b2 + 1) + w.w * light_row(b3 + 1);
		vec4 r2 = w.x * light_row(b0 + 2) + w.y * light_row(b1 + 2) + w.z * light_row(b2 + 2) + w.w * light_row(b3 + 2);
		// r0/r1/r2 are the affine's rows.
		c0 = vec3(r0.x, r1.x, r2.x);
		c1 = vec3(r0.y, r1.y, r2.y);
		c2 = vec3(r0.z, r1.z, r2.z);
		frame_t = vec3(r0.w, r1.w, r2.w);
		frame_origin = light_row(WOW_RIG_ORIGIN_BASE + slot).xyz;
	}

	vec3 n = gfx_input.normal;
	vec3 world_normal;
	if (skin)
		world_normal = wow_normalize(inverse_transpose_apply(c0, c1, c2, n));
	else if (n.x != 0.0 || n.y != 0.0 || n.z != 0.0)
		// `mesh_normal_local_to_world`: the inverse transpose, a zero normal left as is.
		world_normal = normalize(inverse_transpose_apply(c0, c1, c2, n));
	else
		world_normal = n;
	gfx_output.world_normal = world_normal;

	// Camera-relative to clip space; `world_position` is absolute again.
	vec3 p_cam = cols3(c0, c1, c2, gfx_input.position) + frame_t + (frame_origin - world_position.xyz);
	gfx_output.world_position = vec4(p_cam + world_position.xyz, 1.0);
	vec3 p_view = mul(vec4(p_cam, 0.0), view_from_world).xyz;
	vec4 clip = mul(vec4(p_view, 1.0), clip_from_view);
	// The WMO batch order nudge on Bevy's clip z, (1 + n 2^-23).
	clip.z = clip.z * (1.0 + sun_scale.y * 1.1920929e-7);
	// The WMO-skybox lane (bit 13): Bevy clip z = 0, reverse-Z infinitely far.
	if ((markers & 8192u) != 0u)
		clip.z = 0.0;
	gfx_output.merged_fade = 1.0;
	if (merged_fade_on)
	{
		// A fully faded placement leaves the clip volume.
		float fade_d = distance(world_position.xz, gfx_input.fade_sphere.xz);
		gfx_output.merged_fade = merged_fade_alpha(gfx_input.fade_sphere.w, fade_d);
		if (gfx_output.merged_fade <= 0.0)
			clip = vec4(0.0, 0.0, 2.0, 1.0);
	}
	gfx_output.gfx_position = device_clip(clip);

	gfx_output.uv = gfx_input.uv;
	// Env-mapped batches (bit 12) generate their texcoord per vertex (`wow_env_uv`).
	if ((markers & 4096u) != 0u)
		gfx_output.uv = wow_env_uv(p_view, normalize(mul(vec4(world_normal, 0.0), view_from_world).xyz));
	// Stage 1's coordinate in its own interpolant: the generated one, or with `stage1.w` the
	// vertex's UV set 1 (zero on a mesh without one, as the WGSL leaves it).
	gfx_output.stage1_uv = vec2(0.0, 0.0);
	if (stage1.x > 0.5 && stage1.w < 0.5)
		gfx_output.stage1_uv = wow_env_uv(p_view, normalize(mul(vec4(world_normal, 0.0), view_from_world).xyz));
	if ((present & 256u) != 0u && stage1.w > 0.5)
		gfx_output.stage1_uv = gfx_input.uv_b;
	gfx_output.color = gfx_input.color;

	// Point lights: none on WMO surfaces or interior M2 props, else the <=3 nearest the instance
	// origin (clutter: its MCNK chunk).
	vec4 point_lit = vec4(0.0, 0.0, 0.0, 0.0);
	if (model_flags.x < 0.5 && model_flags.z < 0.5)
	{
		vec3 anchor = world_from_local[3].xyz;
		if (clutter_fade.w > 0.5)
			anchor = mcnk_cell_anchor(gfx_output.world_position.xyz);
		point_lit = point_light_sum(gfx_output.world_position.xyz, world_normal, anchor);
	}
	// A merged blob bakes the probe slot per vertex; its tag carries only fog and alpha.
	uint raw_tag = tag.x;
	int probe_slot = merged_slot_on ? gfx_input.merged_slot : int(((raw_tag & 0x3fffffffu) >> 6u) & 0x1fffu);
	gfx_output.primary = vertex_light(world_normal, point_lit, gfx_input.color, probe_slot, raw_tag);
	return gfx_output;
}
