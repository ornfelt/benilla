in 0 vec2 uv

out 0 vec4 color

constant 0 post_block
{
	vec4 lane
	vec4 wave
	vec4 texel
}

sampler 0 2d screen_texture

// The UI lane's one decode (`fs_decode` of `ui_gamma.wgsl`), after the display-gamma ramp
// `pow(i / 255, gamma)`, `lane.x` the clamped `gamma` CVar: the sampled value is the byte the
// reference's RAMDAC would read, and `srgb_to_linear` hands the present its exact byte back.
// Alpha is coverage and passes through.

vec3 srgb_to_linear(vec3 c)
{
	vec3 higher = pow((max(c, vec3(0.0, 0.0, 0.0)) + vec3(0.055, 0.055, 0.055)) / 1.055, vec3(2.4, 2.4, 2.4));
	vec3 lower = c / 12.92;
	return mix(higher, lower, step(c, vec3(0.04045, 0.04045, 0.04045)));
}

fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
	vec4 ui = gfx_sample(screen_texture, gfx_input.uv);
	vec3 rgb = ui.rgb;
	if (lane.x != 1.0)
		rgb = pow(max(rgb, vec3(1e-6, 1e-6, 1e-6)), vec3(lane.x, lane.x, lane.x));
	gfx_output.color = vec4(srgb_to_linear(rgb), ui.a);
	return gfx_output;
}
