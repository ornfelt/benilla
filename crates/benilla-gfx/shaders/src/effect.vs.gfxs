in 0 vec3 position
in 1 vec2 uv
in 2 vec4 color

out 0 vec2 uv
out 1 vec4 color
out 2 float view_z

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 fog
	vec4 mode
}

// The vertex stage of `benilla-world/src/shaders/wow_effect.wgsl`: camera-relative vertices through
// the view's rotation and `clip_from_view`, or, for a coplanar decal (`mode.z`, the WGSL's
// `DECAL_WORLD_CLIP`), absolute ones through `clip_from_world`; the planar eye-Z rides along for
// fog and the far-clip wall.

vs_output gfx_main(vs_input gfx_input)
{
	vs_output gfx_output;
	vec3 p = gfx_input.position;
	if (mode.z > 0.5)
	{
		gfx_output.gfx_position = mul(vec4(p, 1.0), clip_from_world);
		gfx_output.view_z = -mul(vec4(p, 1.0), view_from_world).z;
	}
	else
	{
		// The rebase already took the camera off, so only the rotation applies.
		vec3 view_pos = view_from_world[0].xyz * p.x + view_from_world[1].xyz * p.y + view_from_world[2].xyz * p.z;
		gfx_output.gfx_position = mul(vec4(view_pos, 1.0), clip_from_view);
		gfx_output.view_z = -view_pos.z;
	}
	gfx_output.uv = gfx_input.uv;
	gfx_output.color = gfx_input.color;
	return gfx_output;
}
