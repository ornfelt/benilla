in 0 vec2 uv

out 0 vec4 color

constant 0 post_block
{
	vec4 lane
	vec4 wave
	vec4 texel
}

sampler 0 2d in_tex
sampler 1 2d blur_tex

// FFXGlow's combine (`fs_combine` of `ffx_glow.wgsl`): lerp(screen, blur, z) + w blur^2 on gamma
// values, or the FFXDeath grey while a ghost, then the frame's one gamma decode. `lane` = (w, the
// death gate, the haze z, the dither arm); `texel.w` = the target height, for the top-down pixel
// row the dither hash takes.

vec3 srgb_to_linear(vec3 c)
{
	vec3 lo = c / 12.92;
	vec3 hi = pow((c + vec3(0.055, 0.055, 0.055)) / 1.055, vec3(2.4, 2.4, 2.4));
	return mix(hi, lo, step(c, vec3(0.04045, 0.04045, 0.04045)));
}

vec3 screen_space_dither(vec2 frag_coord)
{
	float d = dot(vec2(171.0, 231.0), frag_coord);
	vec3 dither = fract(vec3(d, d, d) / vec3(103.0, 71.0, 97.0));
	return (dither - vec3(0.5, 0.5, 0.5)) / 255.0;
}

vec4 combine_out(vec3 outg, float alpha, vec2 frag_coord)
{
	vec3 dithered = clamp(outg + screen_space_dither(frag_coord) * step(0.5, lane.w), vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
	// `GAMMA_OUT` (`wave.z`): the UI lane's backdrop stores premultiplied bytes like `ui_quad`;
	// the lane decodes.
	if (wave.z > 0.5)
		return vec4(dithered * alpha, alpha);
	return vec4(srgb_to_linear(dithered), alpha);
}

fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
	vec2 uv = gfx_input.uv;
	vec2 frag = gfx_input.gfx_position.xy;
	if (texel.z < 0.0)
		frag.y = texel.w - frag.y;
	vec4 scene = gfx_sample(in_tex, uv);
	vec3 sg = clamp(scene.rgb, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
	vec3 bg = max(gfx_sample(blur_tex, uv).rgb, vec3(0.0, 0.0, 0.0));
	if (lane.y > 0.0)
	{
		// FFXDeath replaces the glow while a ghost; the 0.144 blue weight is as shipped.
		vec3 glowed = sg + lane.x * bg * bg;
		float luma = clamp(dot(glowed, vec3(0.299, 0.587, 0.144)), 0.0, 1.0);
		float p = clamp(4.0 * luma * (1.0 - luma), 0.0, 1.0);
		vec3 ghost_tint = vec3(83.0, 147.0, 168.0) / 255.0;
		vec3 outd = min(vec3(luma, luma, luma) + ghost_tint * p, vec3(1.0, 1.0, 1.0));
		gfx_output.color = combine_out(outd, scene.a, frag);
		return gfx_output;
	}
	vec3 hazed = mix(sg, min(bg, vec3(1.0, 1.0, 1.0)), lane.z);
	vec3 outg = min(hazed + lane.x * bg * bg, vec3(1.0, 1.0, 1.0));
	gfx_output.color = combine_out(outg, scene.a, frag);
	return gfx_output;
}
