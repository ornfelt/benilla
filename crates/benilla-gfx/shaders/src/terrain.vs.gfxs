in 0 vec3 position
in 1 vec3 normal
in 2 vec2 uv
in 3 vec2 uv_b
in 4 vec4 color

out 0 vec4 world_position
out 1 vec2 uv
out 2 vec2 uv_b
out 3 vec4 color
out 4 vec3 specular
out 5 vec3 primary

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 params
}

// The vertex stage of `benilla-assets/src/shaders/terrain.wgsl` (the ADT splat pass), line for
// line: the sun specular and the whole diffuse sum per vertex, clamped, Gouraud-interpolated.

// The shared light buffer, declared here by hand: the compiler prints samplers in the fragment
// stage only. Same slot as the fragment stage's.
#ifdef GFX_GLSL
#if defined(GFX_VK)
layout(set = 1, binding = 3) uniform sampler2DArray wow_light;
#elif defined(GFX_GL3)
uniform sampler2DArray wow_light;
#else
layout(binding = 3) uniform sampler2DArray wow_light;
#endif
#else
Texture2DArray wow_light : register(t3);
#endif

#define WOW_POINTS_BASE 21
// Terrain's point-light candidacy half-width (yd), `w + 10` on flat ground (see the WGSL).
#define TERRAIN_REACH 33.570166

vec4 light_row(int i)
{
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(wow_light, ivec3(r & 255, r >> 8, layer), 0);
#else
	return wow_light.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

// The chunk's three nearest point lights by the horizontal hash sweep (`point_light_sum`).
vec3 point_light_sum(vec3 P, vec3 N, vec3 anchor)
{
	// At most the 256 lights the table holds (512 rows): a count read off a wrong binding must
	// not spin the GPU into a reset.
	int count = min(int(light_row(20).x), 256);
	int sel0 = 0;
	int sel1 = 0;
	int sel2 = 0;
	float sd0 = 1e30;
	float sd1 = 1e30;
	float sd2 = 1e30;
	for (int i = 0; i < count; i++)
	{
		vec4 pos_range = light_row(WOW_POINTS_BASE + 2 * i);
		vec3 dv = pos_range.xyz - anchor;
		float d2 = dot(dv, dv);
		if (max(abs(dv.x), abs(dv.z)) > TERRAIN_REACH)
			continue;
		if (d2 < sd0)
		{
			sd2 = sd1; sel2 = sel1;
			sd1 = sd0; sel1 = sel0;
			sd0 = d2; sel0 = i;
		}
		else if (d2 < sd1)
		{
			sd2 = sd1; sel2 = sel1;
			sd1 = d2; sel1 = i;
		}
		else if (d2 < sd2)
		{
			sd2 = d2; sel2 = i;
		}
	}
	vec3 sum = vec3(0.0, 0.0, 0.0);
	for (int s = 0; s < 3; s++)
	{
		float sd = s == 0 ? sd0 : (s == 1 ? sd1 : sd2);
		int sel = s == 0 ? sel0 : (s == 1 ? sel1 : sel2);
		if (sd > 9.9e29)
			break;
		vec4 pos_range = light_row(WOW_POINTS_BASE + 2 * sel);
		vec3 to_light = pos_range.xyz - P;
		float d = length(to_light);
		float atten = 1.0 / (0.7 * d + 0.03 * d * d);
		float nl = max(dot(N, to_light / max(d, 1e-4)), 0.0);
		sum += light_row(WOW_POINTS_BASE + 2 * sel + 1).rgb * (atten * nl);
	}
	return sum;
}

// The MCNK chunk cell centre under P (`mcnk_cell_anchor`).
vec3 mcnk_cell_anchor(vec3 P)
{
	float cell = 533.33333 / 16.0;
	float half_extent = 32.0 * 533.33333;
	float ix = floor((half_extent + P.x) / cell);
	float iz = floor((half_extent + P.z) / cell);
	return vec3((ix + 0.5) * cell - half_extent, P.y, (iz + 0.5) * cell - half_extent);
}

// `c0 * v.x + c1 * v.y + c2 * v.z`: a 3x3 by its columns times v.
vec3 cols3(vec3 c0, vec3 c1, vec3 c2, vec3 v)
{
	return c0 * v.x + c1 * v.y + c2 * v.z;
}

// Bevy's clip z, in [0, 1], into [-1, 1] where the device clips depth there (`misc.y` 2 or 3: a
// GL without clip control), as naga's GL writer does.
vec4 device_clip(vec4 clip)
{
	if (misc.y > 1.5)
		clip.z = 2.0 * clip.z - clip.w;
	return clip;
}

vs_output gfx_main(vs_input gfx_input)
{
	vs_output gfx_output;
	vec3 c0 = world_from_local[0].xyz;
	vec3 c1 = world_from_local[1].xyz;
	vec3 c2 = world_from_local[2].xyz;
	vec3 world = cols3(c0, c1, c2, gfx_input.position) + world_from_local[3].xyz;
	gfx_output.world_position = vec4(world, 1.0);
	gfx_output.gfx_position = device_clip(mul(vec4(world, 1.0), clip_from_world));
	// `mesh_normal_local_to_world`: the inverse transpose via the adjugate, a zero normal left.
	vec3 n_in = gfx_input.normal;
	vec3 world_normal = n_in;
	if (n_in.x != 0.0 || n_in.y != 0.0 || n_in.z != 0.0)
	{
		vec3 x = cross(c1, c2);
		vec3 y = cross(c2, c0);
		vec3 z = cross(c0, c1);
		float det = dot(c2, z);
		world_normal = normalize(cols3(x / det, y / det, z / det, n_in));
	}
	gfx_output.uv = gfx_input.uv;
	gfx_output.uv_b = gfx_input.uv_b;
	gfx_output.color = gfx_input.color;

	// Sun specular per vertex: row-9 colour, shininess `light_spec.w`, local viewer.
	vec4 light_sun = light_row(2);
	vec4 light_spec = light_row(3);
	vec3 n = normalize(world_normal);
	vec3 l = -normalize(light_sun.xyz);
	vec3 v = normalize(world_position.xyz - world);
	vec3 h = normalize(l + v);
	float ndoth = max(dot(n, h), 0.0);
	gfx_output.specular = clamp(light_spec.rgb * pow(ndoth, light_spec.w), vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));

	// The whole diffuse sum on the MCNR normal, clamped per vertex.
	float ndotl = max(dot(n, l), 0.0);
	vec3 points = point_light_sum(world, n, mcnk_cell_anchor(world));
	gfx_output.primary = clamp(light_row(0).rgb + light_row(1).rgb * ndotl + points, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
	return gfx_output;
}
