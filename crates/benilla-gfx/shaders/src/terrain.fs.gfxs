in 0 vec4 world_position
in 1 vec2 uv
in 2 vec2 uv_b
in 3 vec4 color
in 4 vec3 specular
in 5 vec3 primary

out 0 vec4 color

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 params
}

sampler 0 2d_array layer_array
sampler 1 2d_array alpha_array
sampler 2 2d_array shadow_array
sampler 3 2d_array wow_light

// The fragment stage of `benilla-assets/src/shaders/terrain.wgsl`, line for line: four tiled
// layers blended by the chunk's alpha map, the MCSH shadow and the `terrainp_s.bls` combine,
// planar eye-Z fog, raw gamma out. The WGSL samples all three arrays through the layers' sampler
// (binding 105); each texture bound here carries that sampler. `params.x` = the layer tiling.

vec4 light_row(int i)
{
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(wow_light, ivec3(r & 255, r >> 8, layer), 0);
#else
	return wow_light.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

vec4 layer_bias(vec2 uv, int layer, float bias)
{
#ifdef GFX_GLSL
	return texture(layer_array, vec3(uv, float(layer)), bias);
#else
	return layer_array.SampleBias(layer_array_sampler, vec3(uv, float(layer)), bias);
#endif
}

vec4 alpha_at(vec2 uv, int layer)
{
#ifdef GFX_GLSL
	return texture(alpha_array, vec3(uv, float(layer)));
#else
	return alpha_array.Sample(alpha_array_sampler, vec3(uv, float(layer)));
#endif
}

float shadow_at(vec2 uv, int layer)
{
#ifdef GFX_GLSL
	return texture(shadow_array, vec3(uv, float(layer))).r;
#else
	return shadow_array.Sample(shadow_array_sampler, vec3(uv, float(layer))).r;
#endif
}

fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
	vec4 fog_params = light_row(5);
	float eye_z = -mul(vec4(gfx_input.world_position.xyz, 1.0), view_from_world).z;
	// The far-clip wall, on planar eye-Z.
	if (fog_params.w > 0.0 && eye_z > fog_params.w)
		discard;

	// Per-chunk array indices baked per vertex: COLOR the 4 layers, UV1.x the alpha.
	ivec4 li = ivec4(round(gfx_input.color));
	int ai = int(round(gfx_input.uv_b.x));
	vec2 tiled = gfx_input.uv * params.x;
	float bias = misc.x;
	vec4 s0 = layer_bias(tiled, li.x, bias);
	vec4 s1 = layer_bias(tiled, li.y, bias);
	vec4 s2 = layer_bias(tiled, li.z, bias);
	vec4 s3 = layer_bias(tiled, li.w, bias);
	// The alpha and shadow maps take the layers' repeat sampler; a half-texel inset clamps.
	vec2 auv = clamp(gfx_input.uv, vec2(0.5 / 64.0, 0.5 / 64.0), vec2(1.0 - 0.5 / 64.0, 1.0 - 0.5 / 64.0));
	vec4 a = alpha_at(auv, ai);

	vec3 color = s0.rgb;
	color = mix(color, s1.rgb, a.r);
	color = mix(color, s2.rgb, a.g);
	color = mix(color, s3.rgb, a.b);
	float specmask = s0.a;
	specmask = mix(specmask, s1.a, a.r);
	specmask = mix(specmask, s2.a, a.g);
	specmask = mix(specmask, s3.a, a.b);

	// MCSH: the shadow map is 1 shadowed, 0 lit; a chunk without one (`uv_b.y < 0`) is lit.
	float shadow_lit = 1.0;
	float si = gfx_input.uv_b.y;
	if (si >= 0.0)
		shadow_lit = 1.0 - shadow_at(auv, int(round(si)));

	vec3 diffuse_term = color * gfx_input.primary * (0.3 * shadow_lit + 0.7);
	vec3 spec_term = gfx_input.specular * specmask * shadow_lit;
	vec3 tuned = clamp(diffuse_term + spec_term, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));

	// Gamma-space linear fog on planar eye-Z.
	vec4 fog_color = light_row(4);
	if (fog_color.w > 0.5)
	{
		float denom = max(fog_params.y - fog_params.x, 0.001);
		float factor = clamp((fog_params.y - eye_z) / denom, 0.0, 1.0);
		tuned = mix(fog_color.xyz, tuned, factor);
	}
	gfx_output.color = vec4(tuned, 1.0);
	return gfx_output;
}
