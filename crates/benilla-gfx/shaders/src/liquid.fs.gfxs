in 0 vec4 world_position
in 1 vec3 world_normal
in 2 vec2 uv
in 3 float depth
in 4 vec3 secondary_vtx
in 5 vec4 vcolor

out 0 vec4 color

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 kind
	vec4 path
	vec4 anim
}

sampler 0 2d_array frames
sampler 1 2d_array wow_light

// The fragment stage of `benilla-assets/src/shaders/liquid.wgsl`, line for line: one arm per
// reference liquid renderer (ADT `ocean0_s.bls`, WMO exterior `MapObjExtWater0.bls`, WMO interior
// fixed function, magma and slime), planar eye-Z fog, raw gamma out. `kind`, `path` and `anim` are
// the extension's rows; `misc.w` is the view's `globals.time`; `tag.x` bit 30 is the room's
// per-frame interior-fog gate.

vec4 light_row(int i)
{
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(wow_light, ivec3(r & 255, r >> 8, layer), 0);
#else
	return wow_light.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

vec4 frame_bias(vec2 uv, float layer, float bias)
{
#ifdef GFX_GLSL
	return texture(frames, vec3(uv, layer), bias);
#else
	return frames.SampleBias(frames_sampler, vec3(uv, layer), bias);
#endif
}

// Planar eye-Z GL_LINEAR fog in gamma space: block 1 (rows 4/5) the scene fog, block 2 (rows
// 18/19) the interior haze where the pool is an interior group's (`kind.z`) and its room gate is up.
vec3 apply_fog(vec3 rgb, vec3 world_pos, bool room_fog)
{
	vec4 fog_color = light_row(4);
	vec2 fog_span = light_row(5).xy;
	if (kind.z > 0.5 && room_fog)
	{
		fog_color = light_row(18);
		fog_span = light_row(19).xy;
	}
	if (fog_color.w <= 0.5)
		return rgb;
	float eye_z = -mul(vec4(world_pos, 1.0), view_from_world).z;
	float denom = max(fog_span.y - fog_span.x, 0.001);
	float factor = clamp((fog_span.y - eye_z) / denom, 0.0, 1.0);
	return mix(fog_color.xyz, rgb, factor);
}

// One row of the 8x64 ADT depth swatch (`swatch_row`), in bytes, the ocean's last row darkened.
vec4 swatch_row(vec4 shallow, vec4 deep, float i, bool ocean)
{
	vec4 c0 = vec4(round(shallow.xyz * 255.0), floor(shallow.w * 255.0));
	vec4 c1 = vec4(round(deep.xyz * 255.0), floor(deep.w * 255.0));
	vec4 row = c0 + floor(i * (c1 - c0) / 64.0);
	if (ocean && i >= 63.0)
		return vec4(floor(row.xyz * 0.9), 255.0) / 255.0;
	return row / 255.0;
}

// The swatch at depth coord `v`, LINEAR across the two rows it falls between (`swatch_at`).
vec4 swatch_at(vec4 shallow, vec4 deep, float v, bool ocean)
{
	float t = clamp(v * 64.0 - 0.5, 0.0, 63.0);
	float i0 = floor(t);
	return mix(swatch_row(shallow, deep, i0, ocean), swatch_row(shallow, deep, min(i0 + 1.0, 63.0), ocean), t - i0);
}

fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
	vec3 world = gfx_input.world_position.xyz;
	bool room_fog = (tag.x & 1073741824u) != 0u;

	// The far-clip wall, as terrain and models: discard beyond `fog_params.w` (0 disables it).
	float farclip = light_row(5).w;
	if (farclip > 0.0)
	{
		float clip_z = -mul(vec4(world, 1.0), view_from_world).z;
		if (clip_z > farclip)
			discard;
	}

	// The animated frame: the 24 fps flip floored to a whole frame (`frame_layer`), the magma and
	// slime v-scroll (`apply_scroll`), at the view's mip bias.
	float t = anim.w * misc.w;
	float frame_count = max(anim.y, 1.0);
	float flip = floor(t * 24.0);
	float layer = flip - frame_count * floor(flip / frame_count);
	vec2 uv = vec2(gfx_input.uv.x, gfx_input.uv.y + anim.z * fract(t / 10.0));
	vec4 detail = frame_bias(uv, layer, misc.x);

	// Magma/slime: the sheet is the opaque body, unmodulated and unlit, but fogged.
	if (kind.x > 0.5)
	{
		gfx_output.color = vec4(apply_fog(detail.xyz, world, room_fog), 1.0);
		return gfx_output;
	}

	float depth = clamp(gfx_input.depth, 0.0, 1.0);
	bool ocean = kind.y > 0.5;
	vec4 shallow = light_row(ocean ? 15 : 13);
	vec4 deep = light_row(ocean ? 16 : 14);
	// The WMO water arms: the authored byte through the zone's linear alpha ramp.
	float vtx_alpha = mix(shallow.w, deep.w, depth);
	if (path.x > 1.5)
	{
		// WMO interior (`0x6b6420`): fixed function, `GL_ADD` on both channels, no light.
		vec3 body = clamp(gfx_input.vcolor.xyz + detail.xyz, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
		gfx_output.color = vec4(apply_fog(body, world, room_fog), clamp(vtx_alpha + detail.w, 0.0, 1.0));
		return gfx_output;
	}

	vec3 n = normalize(gfx_input.world_normal);
	vec3 to_light = -normalize(light_row(2).xyz);
	float ndotl = max(dot(n, to_light), 0.0);
	vec3 lit = clamp(light_row(0).xyz + light_row(1).xyz * ndotl, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
	if (path.x > 0.5)
	{
		// WMO exterior (`MapObjExtWater0.bls`): the lit deep river band, alpha the vertex's alone.
		vec3 rgb_ext = lit * deep.xyz + detail.xyz + gfx_input.secondary_vtx * detail.w;
		gfx_output.color = vec4(apply_fog(rgb_ext, world, room_fog), vtx_alpha);
		return gfx_output;
	}

	// The ADT arm (`ocean0_s.bls`): primary = the lit white vertex, colorTex = the depth swatch.
	vec4 swatch = swatch_at(shallow, deep, depth, ocean);
	vec3 rgb = lit * swatch.xyz + detail.xyz + (gfx_input.secondary_vtx + vec3(0.25, 0.25, 0.25)) * detail.w;
	// Raw gamma out; alpha blends in gamma space like the reference's bytes.
	gfx_output.color = vec4(apply_fog(rgb, world, room_fog), swatch.w);
	return gfx_output;
}
