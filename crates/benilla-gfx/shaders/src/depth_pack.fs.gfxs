in 0 vec2 uv

out 0 vec4 color

sampler 0 2d depth_tex

// The depth probe's readback on a device that reads colour bytes only (gles3): each texel of the
// copied depth, its float's bits as four bytes (least significant in red), into a same-size RGBA8
// target at the same pixel, so the read gives the stored values exactly.
fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
#ifdef GFX_GLSL
	uint bits = floatBitsToUint(texelFetch(depth_tex, ivec2(gfx_input.gfx_position.xy), 0).r);
#else
	uint bits = asuint(depth_tex.Load(int3(int2(gfx_input.gfx_position.xy), 0)).r);
#endif
	gfx_output.color = vec4(float(bits & 255u), float((bits >> 8u) & 255u), float((bits >> 16u) & 255u), float(bits >> 24u)) / 255.0;
	return gfx_output;
}
