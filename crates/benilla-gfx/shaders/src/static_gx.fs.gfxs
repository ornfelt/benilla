in 0 vec4 world_position
in 1 vec3 world_normal
in 2 vec2 uv
in 3 vec4 color
in 4 vec3 point_lit
in 5 int word

out 0 vec4 color

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 gx
}

sampler 0 2d gx_texture
sampler 1 2d_array wow_light
sampler 2 2d_array gx_records

// The fragment stage of `benilla-world/src/shaders/static_gx.wgsl`, line for line. The WGSL
// samples one texture array through a repeat and a clamp sampler and picks by the item's wrap
// bits; here each draw binds its item's texture already carrying the sampler the WGSL would
// pick (repeat when either axis wraps, else clamp), and `gx` holds the texture's size (xy, for
// the mixed-wrap half-texel clamp) and z = 1 on the cutout pipeline (`GX_CUTOUT`).

#define WOW_PROBES_BASE 533
#define WORD_WRAP_X 65536u
#define WORD_WRAP_Y 131072u
#define WORD_UNLIT 262144u
#define WORD_FOG_OFF 524288u
#define WORD_SHADE_LIT 1048576u
#define WORD_TEXTURED 2097152u
#define WORD_WMO 4194304u
#define WORD_INTERIOR 8388608u
#define WORD_CLASS_INT 16777216u
#define WORD_CLASS_TRANS 33554432u
#define WORD_WINDOW 67108864u
#define WORD_HAS_VC 134217728u
#define WORD_MATTE 268435456u

// The alpha-test cutout reference 224/255, as wow_model's VANILLA_ALPHA_KEY.
#define VANILLA_ALPHA_KEY 0.8784314

vec4 light_row(int i)
{
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(wow_light, ivec3(r & 255, r >> 8, layer), 0);
#else
	return wow_light.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

vec4 record(uint word)
{
	int i = int(word & 0xffffu);
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(gx_records, ivec3(r & 255, r >> 8, layer), 0);
#else
	return gx_records.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

vec4 sample_bias(vec2 uv, float bias)
{
#ifdef GFX_GLSL
	return texture(gx_texture, uv, bias);
#else
	return gx_texture.SampleBias(gx_texture_sampler, uv, bias);
#endif
}

vec3 wow_normalize(vec3 v)
{
	float l2 = dot(v, v);
	return l2 > 1e-12 ? normalize(v) : vec3(0.0, 0.0, 0.0);
}

vec3 clamp01(vec3 v)
{
	return clamp(v, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
}

fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
	uint word = uint(gfx_input.word);
	vec4 rec = record(word);
	uint rec_flags = uint(rec.w);
	// The hard farclip wall: per-pixel planar eye-Z, the same plane as the entity path.
	float eye_z = -mul(vec4(gfx_input.world_position.xyz, 1.0), view_from_world).z;
	vec4 fog_params = light_row(5);
	if (fog_params.w > 0.0 && eye_z > fog_params.w)
		discard;
	// The texel: one sample, unconditionally, at the view's mip bias; a mixed-wrap item clamps
	// its clamped axis a half texel in on the repeat texture.
	bool wrap_x = (word & WORD_WRAP_X) != 0u;
	bool wrap_y = (word & WORD_WRAP_Y) != 0u;
	vec2 uv = gfx_input.uv;
	if (wrap_x != wrap_y)
	{
		vec2 inset = vec2(0.5, 0.5) / max(gx.xy, vec2(1.0, 1.0));
		if (!wrap_x)
			uv.x = clamp(uv.x, inset.x, 1.0 - inset.x);
		if (!wrap_y)
			uv.y = clamp(uv.y, inset.y, 1.0 - inset.y);
	}
	vec4 texel = sample_bias(uv, misc.x);
	vec4 base = (word & WORD_TEXTURED) != 0u ? texel : vec4(1.0, 1.0, 1.0, 1.0);
	if (gx.z > 0.5 && base.a < VANILLA_ALPHA_KEY)
		discard;
	// Both faces light from the submitted normal (no GL_LIGHT_MODEL_TWO_SIDE in the reference).
	vec4 light_ambient = light_row(0);
	vec4 light_diffuse = light_row(1);
	vec4 light_sun = light_row(2);
	vec4 grade = light_row(17);
	vec3 n_lit = wow_normalize(gfx_input.world_normal);
	vec3 L = -normalize(light_sun.xyz);
	float ndotl = max(dot(n_lit, L), 0.0);
	vec3 lit_nl = clamp01(light_ambient.rgb + light_diffuse.rgb * ndotl);
	vec4 quad = vec4(n_lit.x * n_lit.y, n_lit.y * n_lit.z, n_lit.z * n_lit.z, n_lit.x * n_lit.z);
	float x2y2 = n_lit.x * n_lit.x - n_lit.y * n_lit.y;
	// A colour-less batch takes a constant 1.0, not interpolated white.
	bool has_vc = (word & WORD_HAS_VC) != 0u;
	vec4 vc = has_vc ? gfx_input.color : vec4(1.0, 1.0, 1.0, 1.0);
	vec3 folded = has_vc ? base.rgb * vc.rgb : base.rgb;
	vec3 rgb;
	if ((word & WORD_WMO) != 0u)
	{
		// WMO surfaces: wow_model's is_wmo branch.
		bool interior = (word & WORD_INTERIOR) != 0u;
		bool class_int = (word & WORD_CLASS_INT) != 0u;
		bool class_trans = (word & WORD_CLASS_TRANS) != 0u;
		float trans_a = vc.a;
		vec3 window_mid = 0.5 * (light_ambient.rgb + light_diffuse.rgb);
		vec3 lit_window = clamp01(window_mid + vec3(16.0 / 255.0, 16.0 / 255.0, 16.0 / 255.0) + window_mid * ndotl);
		vec3 lit_int_base = (word & WORD_WINDOW) != 0u ? lit_window : lit_nl;
		vec3 lit_wmo_interior = vec3(1.0, 1.0, 1.0);
		if (class_trans)
			lit_wmo_interior = mix(vec3(1.0, 1.0, 1.0), lit_int_base, trans_a);
		else if (!class_int)
			lit_wmo_interior = lit_int_base;
		vec3 lit_wmo = interior ? lit_wmo_interior : lit_nl;
		// SIDN night glow (MOMT 0x10): zero on INT, MOCV-alpha weighted on TRANS.
		uint sidn_word = uint(rec.z);
		vec3 sidn_rgb = vec3(float(sidn_word & 0xffu), float((sidn_word >> 8u) & 0xffu), float((sidn_word >> 16u) & 0xffu)) / 255.0;
		float sidn_w = 1.0;
		if (interior)
		{
			if (class_trans)
				sidn_w = trans_a;
			else if (class_int)
				sidn_w = 0.0;
		}
		vec3 sidn_e = sidn_rgb * (grade.x * sidn_w);
		vec3 primary = clamp01(vc.rgb * (lit_wmo + gfx_input.point_lit) + sidn_e);
		vec3 tex_rgb = folded / max(vc.rgb, vec3(1.0 / 255.0, 1.0 / 255.0, 1.0 / 255.0));
		rgb = tex_rgb * primary;
		if (interior && class_int && has_vc)
			rgb = clamp01(tex_rgb * vc.rgb * (1.0 + 4.0 * trans_a));
	}
	else if ((word & WORD_INTERIOR) != 0u)
	{
		// Interior M2 props: the spawn-folded SH probe over the fragment normal.
		int probe = WOW_PROBES_BASE + 7 * int((rec_flags >> 1u) & 0x1fffu);
		vec4 n1 = vec4(n_lit, 1.0);
		vec4 p6 = light_row(probe + 6);
		vec3 lit_prop = clamp01(vec3(
			dot(light_row(probe), n1) + dot(light_row(probe + 3), quad) + p6.x * x2y2,
			dot(light_row(probe + 1), n1) + dot(light_row(probe + 4), quad) + p6.y * x2y2,
			dot(light_row(probe + 2), n1) + dot(light_row(probe + 5), quad) + p6.z * x2y2));
		vec3 primary = clamp01(lit_prop + gfx_input.point_lit);
		rgb = folded * primary;
	}
	else
	{
		// Exterior ADT doodads and exterior MODD props: the Model2.bls order-2 SH sun lobe at
		// 0.5 Shaded, 1.0 Matte, 2.5 Lit, capped at 1 (see the WGSL).
		float shade_t = (word & WORD_SHADE_LIT) != 0u ? 0.0 : 1.0;
		float intensity = min((word & WORD_MATTE) != 0u ? 1.0 : mix(2.5, 0.5, shade_t), 1.0);
		vec3 sun_dc = grade.yzw * intensity;
		vec4 sh_c10_r = light_row(6);
		vec4 sh_c10_g = light_row(7);
		vec4 sh_c10_b = light_row(8);
		vec4 sh_c16 = light_row(12);
		vec3 sun_lobe = vec3(
			sh_c10_r.w + sun_dc.x + intensity * (dot(sh_c10_r.xyz, n_lit) + dot(light_row(9), quad) + sh_c16.x * x2y2),
			sh_c10_g.w + sun_dc.y + intensity * (dot(sh_c10_g.xyz, n_lit) + dot(light_row(10), quad) + sh_c16.y * x2y2),
			sh_c10_b.w + sun_dc.z + intensity * (dot(sh_c10_b.xyz, n_lit) + dot(light_row(11), quad) + sh_c16.z * x2y2));
		vec3 lit_doodad = clamp01(sun_lobe);
		vec3 lit = light_sun.w > 0.5 ? lit_doodad : lit_nl;
		vec3 primary = clamp01(lit + gfx_input.point_lit);
		rgb = folded * primary;
	}
	// Unlit: texture x vertex colour, no light.
	if ((word & WORD_UNLIT) != 0u)
		rgb = folded;
	// Planar eye-Z fog; the interior triple keys on the per-frame record bit 14.
	vec4 fog_color = light_row(4);
	vec2 fog_span = fog_params.xy;
	if ((rec_flags & 16384u) != 0u)
	{
		fog_color = light_row(18);
		fog_span = light_row(19).xy;
	}
	if (fog_color.w > 0.5 && (word & WORD_FOG_OFF) == 0u)
	{
		float denom = max(fog_span.y - fog_span.x, 0.001);
		float factor = clamp((fog_span.y - eye_z) / denom, 0.0, 1.0);
		rgb = mix(fog_color.xyz, rgb, factor);
	}
	// Gamma-space output, decoded once in the FFXGlow combine; every draw here is opaque.
	gfx_output.color = vec4(rgb, 1.0);
	return gfx_output;
}
