in 0 vec4 tint
in 1 vec2 uv

out 0 vec4 color

constant 0 egui_block
{
	vec4 transform
}

sampler 0 2d image_texture

// `fs_main` of bevy_egui 0.39.1's `egui.wgsl`: the texel (an sRGB texture, decoded by the
// sample) back to gamma, times the vertex colour in gamma as egui multiplies, then linear for
// the 8-bit sRGB target's encoding store, premultiplied.

vec3 linear_to_srgb(vec3 c)
{
	vec3 cc = max(c, vec3(0.0, 0.0, 0.0));
	vec3 higher = 1.055 * pow(cc, vec3(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) - vec3(0.055, 0.055, 0.055);
	vec3 lower = c * 12.92;
	return mix(higher, lower, step(c, vec3(0.0031308, 0.0031308, 0.0031308)));
}

vec3 srgb_to_linear(vec3 c)
{
	vec3 cc = max(c, vec3(0.0, 0.0, 0.0));
	vec3 higher = pow((cc + vec3(0.055, 0.055, 0.055)) / 1.055, vec3(2.4, 2.4, 2.4));
	vec3 lower = c / 12.92;
	return mix(higher, lower, step(c, vec3(0.04045, 0.04045, 0.04045)));
}

fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
	vec4 texel = gfx_sample(image_texture, gfx_input.uv);
	vec4 gamma = vec4(linear_to_srgb(texel.rgb), texel.a) * gfx_input.tint;
	gfx_output.color = vec4(srgb_to_linear(gamma.rgb), gamma.a);
	return gfx_output;
}
