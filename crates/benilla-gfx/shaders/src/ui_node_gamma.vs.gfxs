in 0 vec3 position
in 1 vec2 uv
in 2 vec4 color
in 3 int flags
in 4 vec4 radius
in 5 vec4 border
in 6 vec2 size
in 7 vec2 node_point

out 0 vec2 uv
out 1 vec4 color
out 2 vec2 size
out 3 int flags
out 4 vec4 radius
out 5 vec4 border
out 6 vec2 node_point

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 options
}

// `ui_node_gamma.wgsl`'s vertex stage (bevy_ui_render 0.18.1 `ui.wgsl`): the node's physical-pixel
// position through the UI view's projection; size, flags, radius and border are one value per
// quad, so interpolating them keeps the WGSL's flat values.

vs_output gfx_main(vs_input gfx_input)
{
	vs_output gfx_output;
	gfx_output.gfx_position = mul(vec4(gfx_input.position, 1.0), clip_from_world);
	gfx_output.uv = gfx_input.uv;
	gfx_output.color = gfx_input.color;
	gfx_output.size = gfx_input.size;
	gfx_output.flags = gfx_input.flags;
	gfx_output.radius = gfx_input.radius;
	gfx_output.border = gfx_input.border;
	gfx_output.node_point = gfx_input.node_point;
	return gfx_output;
}
