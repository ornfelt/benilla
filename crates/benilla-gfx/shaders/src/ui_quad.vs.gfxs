in 0 vec3 position
in 1 vec2 uv
in 2 vec4 color

out 0 vec2 uv
out 1 vec4 color

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 modes
	vec4 test
	vec4 mask_rect
	vec4 uv_clamp
}

// `ui_quad.wgsl`'s vertex stage: the Mesh2d position through the world matrix and the view, the
// UV and the vertex colour (white where the mesh has none, as without `VERTEX_COLORS`). The run's
// tint is the draw's tag, which the fragment stage unpacks.

vs_output gfx_main(vs_input gfx_input)
{
	vs_output gfx_output;
	vec4 world = mul(vec4(gfx_input.position, 1.0), world_from_local);
	gfx_output.gfx_position = mul(world, clip_from_world);
	gfx_output.uv = gfx_input.uv;
	gfx_output.color = gfx_input.color;
	return gfx_output;
}
