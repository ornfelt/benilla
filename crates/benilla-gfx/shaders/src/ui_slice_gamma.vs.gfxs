in 0 vec3 position
in 1 vec2 uv
in 2 vec4 color
in 3 vec4 texture_slices
in 4 vec4 target_slices
in 5 vec4 repeat
in 6 vec4 atlas_rect

out 0 vec2 uv
out 1 vec4 color
out 2 vec4 texture_slices
out 3 vec4 target_slices
out 4 vec4 repeat
out 5 vec4 atlas_rect

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
}

// `ui_slice_gamma.wgsl`'s vertex stage (bevy_ui_render 0.18.1 `ui_texture_slice.wgsl`); the slice
// rows are one value per quad, so interpolating them keeps the WGSL's flat values.

vs_output gfx_main(vs_input gfx_input)
{
	vs_output gfx_output;
	gfx_output.gfx_position = mul(vec4(gfx_input.position, 1.0), clip_from_world);
	gfx_output.uv = gfx_input.uv;
	gfx_output.color = gfx_input.color;
	gfx_output.texture_slices = gfx_input.texture_slices;
	gfx_output.target_slices = gfx_input.target_slices;
	gfx_output.repeat = gfx_input.repeat;
	gfx_output.atlas_rect = gfx_input.atlas_rect;
	return gfx_output;
}
