in 0 vec2 uv
in 1 vec4 color

out 0 vec4 color

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 modes
	vec4 test
	vec4 mask_rect
	vec4 uv_clamp
}

sampler 0 2d quad_texture
sampler 1 2d mask_texture

// The player-UI quad (`fragment` of `ui_quad.wgsl`): tint and premultiply on gamma bytes for the
// `(One, OneMinusSrcAlpha)` blend into the UI lane's byte target. `modes` = (additive, circular,
// desaturate, premultiplied), `test` = (the alpha-test reference, <= 0 off; gamma_texel),
// `mask_rect` = the screen mask's span in physical px (z <= x off), `uv_clamp` = the sampled UV
// window (min > max leaves an axis unclamped). `tag.x` is the run's tint, a byte a channel,
// complemented so no tag is opaque white.

vec3 linear_to_srgb(vec3 c)
{
	vec3 cc = max(c, vec3(0.0, 0.0, 0.0));
	vec3 higher = 1.055 * pow(cc, vec3(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) - vec3(0.055, 0.055, 0.055);
	vec3 lower = c * 12.92;
	return mix(higher, lower, step(c, vec3(0.0031308, 0.0031308, 0.0031308)));
}

vec3 srgb_to_linear(vec3 c)
{
	vec3 cc = max(c, vec3(0.0, 0.0, 0.0));
	vec3 higher = pow((cc + vec3(0.055, 0.055, 0.055)) / 1.055, vec3(2.4, 2.4, 2.4));
	vec3 lower = c / 12.92;
	return mix(higher, lower, step(c, vec3(0.04045, 0.04045, 0.04045)));
}

vec4 unpack_tint(uint word)
{
	uint t = ~word;
	return vec4(float(t & 255u), float((t >> 8u) & 255u), float((t >> 16u) & 255u), float(t >> 24u)) / 255.0;
}

float sample_mask(vec2 uv)
{
#ifdef GFX_GLSL
	return textureLod(mask_texture, uv, 0.0).a;
#else
	return mask_texture.SampleLevel(mask_texture_sampler, uv, 0.0).a;
#endif
}

fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
	vec2 lo = min(uv_clamp.xy, uv_clamp.zw);
	vec2 hi = max(uv_clamp.xy, uv_clamp.zw);
	vec2 on = step(uv_clamp.xy, uv_clamp.zw);
	vec2 uv = mix(gfx_input.uv, clamp(gfx_input.uv, lo, hi), on);
	vec4 t = gfx_sample(quad_texture, uv);
	vec4 c = gfx_input.color * unpack_tint(tag.x);
	vec3 texel = test.y != 0.0 ? t.rgb : linear_to_srgb(t.rgb);
	vec3 rgb = texel * c.rgb;
	if (modes.z != 0.0)
	{
		float l = dot(texel, vec3(0.299, 0.587, 0.114));
		rgb = vec3(l, l, l);
	}
	float k = c.a;
	if (modes.y != 0.0)
		k *= 1.0 - smoothstep(0.48, 0.5, distance(gfx_input.uv, vec2(0.5, 0.5)));
	if (mask_rect.z > mask_rect.x)
	{
		// The physical pixel, top-down: the rows run bottom-up where `misc.y` is 1 or 3 (GL, but
		// for a target drawn top-down).
		vec2 frag = gfx_input.gfx_position.xy;
		if ((misc.y > 0.5 && misc.y < 1.5) || misc.y > 2.5)
			frag.y = misc.z - frag.y;
		vec2 muv = (frag - mask_rect.xy) / (mask_rect.zw - mask_rect.xy);
		float inside = (muv.x >= 0.0 && muv.y >= 0.0 && muv.x <= 1.0 && muv.y <= 1.0) ? 1.0 : 0.0;
		float m = sample_mask(clamp(muv, vec2(0.0, 0.0), vec2(1.0, 1.0)));
		k *= m * inside;
	}
	if (test.x > 0.0)
	{
		if (t.a * c.a < test.x)
			discard;
		gfx_output.color = vec4(srgb_to_linear(t.rgb) * c.rgb, 1.0);
		return gfx_output;
	}
	float a = t.a * k;
	float weight = modes.w != 0.0 ? k : a;
	if (modes.x != 0.0)
		gfx_output.color = vec4(rgb * weight, 0.0);
	else
		gfx_output.color = vec4(rgb * weight, a);
	return gfx_output;
}
