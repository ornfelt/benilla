in 0 vec3 position
in 1 vec3 normal
in 2 vec2 uv
in 3 vec4 color
in 4 int word
in 5 vec3 anchor

out 0 vec4 world_position
out 1 vec2 uv
out 2 vec4 color
out 3 vec3 primary
out 4 int word

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 gx
}

// The vertex stage of `benilla-world/src/shaders/static_gx.wgsl` (the retained static-world
// pass), line for line. `world_from_local` is the region's recentring origin as a translation;
// the per-item records are a data texture (`gx_records`, 256x16 rows a layer) of floats:
// y the WMO batch order, z the SIDN colour r|g<<8|b<<16, w the flags (bit 0 exile kill, 1..=13
// the probe slot, 14 interior fog).

// The shared light buffer and the record table, declared here by hand: the compiler prints
// samplers in the fragment stage only. Same slots as the fragment stage's.
#ifdef GFX_GLSL
#if defined(GFX_VK)
layout(set = 1, binding = 1) uniform sampler2DArray wow_light;
layout(set = 1, binding = 2) uniform sampler2DArray gx_records;
#elif defined(GFX_GL3)
uniform sampler2DArray wow_light;
uniform sampler2DArray gx_records;
#else
layout(binding = 1) uniform sampler2DArray wow_light;
layout(binding = 2) uniform sampler2DArray gx_records;
#endif
#else
Texture2DArray wow_light : register(t1);
Texture2DArray gx_records : register(t2);
#endif

#define WOW_PROBES_BASE 533
#define WOW_POINTS_BASE 21
#define WORD_SHADE_LIT 1048576u
#define WORD_WMO 4194304u
#define WORD_INTERIOR 8388608u
#define WORD_CLASS_INT 16777216u
#define WORD_WINDOW 67108864u
#define WORD_HAS_VC 134217728u
#define WORD_MATTE 268435456u

vec4 light_row(int i)
{
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(wow_light, ivec3(r & 255, r >> 8, layer), 0);
#else
	return wow_light.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

vec4 record(uint word)
{
	int i = int(word & 0xffffu);
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(gx_records, ivec3(r & 255, r >> 8, layer), 0);
#else
	return gx_records.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

vec3 wow_normalize(vec3 v)
{
	float l2 = dot(v, v);
	return l2 > 1e-12 ? normalize(v) : vec3(0.0, 0.0, 0.0);
}

vec3 clamp01(vec3 v)
{
	return clamp(v, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
}

// The <=3 point lights nearest `anchor` (`point_light_sum`, mirrored from `wow_model.vs.gfxs`);
// `.w` counts the bound ones.
vec4 point_light_sum(vec3 P, vec3 N, vec3 anchor)
{
	// At most the 256 lights the table holds (512 rows): a count read off a wrong binding must
	// not spin the GPU into a reset.
	int count = min(int(light_row(20).x), 256);
	int sel0 = 0;
	int sel1 = 0;
	int sel2 = 0;
	float sd0 = 1e30;
	float sd1 = 1e30;
	float sd2 = 1e30;
	for (int i = 0; i < count; i++)
	{
		vec4 pos_range = light_row(WOW_POINTS_BASE + 2 * i);
		vec3 dv = pos_range.xyz - anchor;
		float d2 = dot(dv, dv);
		if (d2 > pos_range.w * pos_range.w)
			continue;
		if (d2 < sd0)
		{
			sd2 = sd1; sel2 = sel1;
			sd1 = sd0; sel1 = sel0;
			sd0 = d2; sel0 = i;
		}
		else if (d2 < sd1)
		{
			sd2 = sd1; sel2 = sel1;
			sd1 = d2; sel1 = i;
		}
		else if (d2 < sd2)
		{
			sd2 = d2; sel2 = i;
		}
	}
	vec4 sum = vec4(0.0, 0.0, 0.0, 0.0);
	for (int s = 0; s < 3; s++)
	{
		float sd = s == 0 ? sd0 : (s == 1 ? sd1 : sd2);
		int sel = s == 0 ? sel0 : (s == 1 ? sel1 : sel2);
		if (sd > 9.9e29)
			break;
		vec4 pos_range = light_row(WOW_POINTS_BASE + 2 * sel);
		vec3 to_light = pos_range.xyz - P;
		float d = length(to_light);
		float atten = 1.0 / (0.7 * d + 0.03 * d * d);
		float nl = max(dot(N, to_light / max(d, 1e-4)), 0.0);
		sum += vec4(light_row(WOW_POINTS_BASE + 2 * sel + 1).rgb * (atten * nl), 1.0);
	}
	return sum;
}

// The lit colour at one vertex (`vertex_light`): the reference lights per vertex and interpolates
// the clamped colour, the vertex colour inside the clamp as the lit material. `vc` is the vertex
// colour, white where the batch authors none; `point_lit.w` counts the bound point lights.
vec3 vertex_light(vec3 normal, vec4 point_lit, vec4 vc, uint word, vec4 rec)
{
	vec4 light_ambient = light_row(0);
	vec4 light_diffuse = light_row(1);
	vec4 light_sun = light_row(2);
	vec4 grade = light_row(17);
	vec3 n_lit = wow_normalize(normal);
	vec3 L = -normalize(light_sun.xyz);
	float ndotl = max(dot(n_lit, L), 0.0);
	// The FFP light sum, unclamped: GL clamps the lit colour once, after the material colour.
	vec3 sum_nl = light_ambient.rgb + light_diffuse.rgb * ndotl;
	if ((word & WORD_WMO) != 0u)
	{
		// WMO surfaces: INT unlit, TRANS's lit pass and EXT the FFP sum; a WINDOW batch on the
		// interior drawer lights at the Direct/Ambient midpoint, its +16/255 ambient saturating
		// on its own.
		vec3 window_mid = 0.5 * (light_ambient.rgb + light_diffuse.rgb);
		vec3 sum_window = min(window_mid + vec3(16.0 / 255.0, 16.0 / 255.0, 16.0 / 255.0), vec3(1.0, 1.0, 1.0)) + window_mid * ndotl;
		vec3 sum_wmo = sum_nl;
		// SIDN night glow (MOMT 0x10): an emission term inside the clamp; zero on INT.
		float sidn_w = 1.0;
		if ((word & WORD_INTERIOR) != 0u)
		{
			sum_wmo = (word & WORD_WINDOW) != 0u ? sum_window : sum_nl;
			if ((word & WORD_CLASS_INT) != 0u)
			{
				sum_wmo = vec3(1.0, 1.0, 1.0);
				sidn_w = 0.0;
			}
		}
		uint sidn_word = uint(rec.z);
		vec3 sidn_rgb = vec3(float(sidn_word & 0xffu), float((sidn_word >> 8u) & 0xffu), float((sidn_word >> 16u) & 0xffu)) / 255.0;
		vec3 sidn_e = sidn_rgb * (grade.x * sidn_w);
		// GL_COLOR_MATERIAL: MOCV multiplies the light sum inside the clamp; emission adds beside.
		return clamp01(vc.rgb * sum_wmo + sidn_e);
	}
	vec4 quad = vec4(n_lit.x * n_lit.y, n_lit.y * n_lit.z, n_lit.z * n_lit.z, n_lit.x * n_lit.z);
	float x2y2 = n_lit.x * n_lit.x - n_lit.y * n_lit.y;
	vec3 e;
	if ((word & WORD_INTERIOR) != 0u)
	{
		// Interior M2 props: the spawn-folded SH probe over the vertex normal.
		int probe = WOW_PROBES_BASE + 7 * int((uint(rec.w) >> 1u) & 0x1fffu);
		vec4 n1 = vec4(n_lit, 1.0);
		vec4 p6 = light_row(probe + 6);
		e = vec3(
			dot(light_row(probe), n1) + dot(light_row(probe + 3), quad) + p6.x * x2y2,
			dot(light_row(probe + 1), n1) + dot(light_row(probe + 4), quad) + p6.y * x2y2,
			dot(light_row(probe + 2), n1) + dot(light_row(probe + 5), quad) + p6.z * x2y2);
	}
	else
	{
		// Exterior ADT doodads and exterior MODD props: the Model2.bls order-2 SH sun lobe at
		// 0.5 Shaded, 1.0 Matte, 2.5 Lit, unclamped; only the per-vertex sum clamps.
		float shade_t = (word & WORD_SHADE_LIT) != 0u ? 0.0 : 1.0;
		float intensity = (word & WORD_MATTE) != 0u ? 1.0 : mix(2.5, 0.5, shade_t);
		vec3 sun_dc = grade.yzw * intensity;
		vec4 sh_c10_r = light_row(6);
		vec4 sh_c10_g = light_row(7);
		vec4 sh_c10_b = light_row(8);
		vec4 sh_c16 = light_row(12);
		vec3 sun_lobe = vec3(
			sh_c10_r.w + sun_dc.x + intensity * (dot(sh_c10_r.xyz, n_lit) + dot(light_row(9), quad) + sh_c16.x * x2y2),
			sh_c10_g.w + sun_dc.y + intensity * (dot(sh_c10_g.xyz, n_lit) + dot(light_row(10), quad) + sh_c16.y * x2y2),
			sh_c10_b.w + sun_dc.z + intensity * (dot(sh_c10_b.xyz, n_lit) + dot(light_row(11), quad) + sh_c16.z * x2y2));
		// Sun disabled (light_sun.w) falls back to the FFP sum.
		e = light_sun.w > 0.5 ? sun_lobe : sum_nl;
	}
	// `Model2.bls`: with a point light bound E clamps to [0, 1] before `c28` multiplies it.
	e += point_lit.rgb;
	if (point_lit.w > 0.5)
		e = clamp01(e);
	// `c28`: the vertex colour, the M2Color baked constant, is the lit material.
	return clamp01(vc.rgb * e);
}

// Bevy's clip z, in [0, 1], into [-1, 1] where the device clips depth there (`misc.y` 2 or 3: a
// GL without clip control), as naga's GL writer does.
vec4 device_clip(vec4 clip)
{
	if (misc.y > 1.5)
		clip.z = 2.0 * clip.z - clip.w;
	return clip;
}

vs_output gfx_main(vs_input gfx_input)
{
	vs_output gfx_output;
	uint word = uint(gfx_input.word);
	vec4 rec = record(word);
	gfx_output.word = gfx_input.word;
	// Exile kill bit: every vertex of the item collapses to one point outside the clip volume.
	if ((uint(rec.w) & 1u) != 0u)
	{
		gfx_output.gfx_position = vec4(0.0, 0.0, 2.0, 1.0);
		gfx_output.world_position = vec4(0.0, 0.0, 0.0, 0.0);
		gfx_output.uv = vec2(0.0, 0.0);
		gfx_output.primary = vec3(0.0, 0.0, 0.0);
		gfx_output.color = vec4(1.0, 1.0, 1.0, 1.0);
		return gfx_output;
	}
	// Camera-relative for f32 precision: the recentred vertex plus (cell origin - camera).
	vec3 origin = world_from_local[3].xyz;
	vec3 p_cam = gfx_input.position + (origin - world_position.xyz);
	vec3 world = gfx_input.position + origin;
	gfx_output.world_position = vec4(world, 1.0);
	vec3 p_view = mul(vec4(p_cam, 0.0), view_from_world).xyz;
	vec4 clip = mul(vec4(p_view, 1.0), clip_from_view);
	// The authored MOBA batch order on Bevy's clip z, (1 + n 2^-23).
	clip.z = clip.z * (1.0 + rec.y * 1.1920929e-7);
	gfx_output.gfx_position = device_clip(clip);
	gfx_output.uv = gfx_input.uv;
	gfx_output.color = gfx_input.color;
	// Point lights: none on WMO surfaces or interior props, else the <=3 nearest the placement.
	vec4 point_lit = vec4(0.0, 0.0, 0.0, 0.0);
	if ((word & (WORD_WMO | WORD_INTERIOR)) == 0u)
		point_lit = point_light_sum(world, gfx_input.normal, gfx_input.anchor);
	// A colour-less batch takes a constant 1.0 (WORD_HAS_VC).
	vec4 vc = (word & WORD_HAS_VC) != 0u ? gfx_input.color : vec4(1.0, 1.0, 1.0, 1.0);
	gfx_output.primary = vertex_light(gfx_input.normal, point_lit, vc, word, rec);
	return gfx_output;
}
