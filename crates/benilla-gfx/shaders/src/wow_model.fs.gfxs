in 0 vec4 world_position
in 1 vec3 world_normal
in 2 vec2 uv
in 3 vec4 color
in 4 vec3 point_lit
in 5 float merged_fade
in 6 int merged_slot

out 0 vec4 color

constant 0 view_block
{
	mat4 clip_from_world
	mat4 view_from_world
	mat4 clip_from_view
	vec4 world_position
	vec4 viewport
	vec4 misc
}

constant 1 draw_block
{
	mat4 world_from_local
	uvec4 tag
	vec4 base_color
	vec4 uv_matrix
	vec4 uv_offset_cutoff_mode
	vec4 flags
	vec4 clutter_fade
	vec4 model_flags
	vec4 sun_scale
	vec4 tint
	vec4 sidn
	vec4 anim_slots
}

sampler 0 2d base_color_texture
sampler 1 2d_array wow_light

// The fragment stage of `benilla-assets/src/shaders/wow_model.wgsl`, line for line, with
// bevy_pbr's `pbr_input_from_standard_material` and `alpha_discard` folded in: base colour =
// material colour x vertex colour x texel, the texel at the StandardMaterial UV transform and the
// view's mip bias. `tag.y` bits: 3 = `VERTEX_COLORS`, 6 = `WOW_MERGED_FADE`, 7 = `WOW_MERGED_SLOT`;
// `flags.x` = `WOW_WATER_CLIP` (the blend pass).
//
// Bevy negates a double-sided back face's normal and the WGSL negates it back, and every model
// material is double-sided exactly when it culls nothing, so the lit normal is the interpolated
// one on either face: no `front_facing` here, which the HLSL entry point cannot take.

#define WOW_PROBES_BASE 533
#define WOW_RIG_TINT_BASE 58389
#define WOW_MATANIM_BASE 60949
#define WOW_WATER_CLIP_BASE 62997

// The M2 cutout alpha-test reference, 224/255 (`materials::VANILLA_ALPHA_KEY_REF`).
#define VANILLA_ALPHA_KEY 0.8784314
// The detail-doodad pass's stage-0 LOD bias (`0x6813f4`).
#define DETAIL_DOODAD_LOD_BIAS 0.25

vec4 light_row(int i)
{
	int layer = i >> 12;
	int r = i & 4095;
#ifdef GFX_GLSL
	return texelFetch(wow_light, ivec3(r & 255, r >> 8, layer), 0);
#else
	return wow_light.Load(int4(r & 255, r >> 8, layer, 0));
#endif
}

vec4 sample_bias(vec2 uv, float bias)
{
#ifdef GFX_GLSL
	return texture(base_color_texture, uv, bias);
#else
	return base_color_texture.SampleBias(base_color_texture_sampler, uv, bias);
#endif
}

vec3 wow_normalize(vec3 v)
{
	float l2 = dot(v, v);
	return l2 > 1e-12 ? normalize(v) : vec3(0.0, 0.0, 0.0);
}

vec3 clamp01(vec3 v)
{
	return clamp(v, vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0));
}

fs_output gfx_main(fs_input gfx_input)
{
	fs_output gfx_output;
	uint present = tag.y;
	bool has_colors = (present & 8u) != 0u;
	bool merged_fade_on = (present & 64u) != 0u;
	bool merged_slot_on = merged_fade_on && (present & 128u) != 0u;
	uint markers = uint(clutter_fade.z);
	vec3 wp = gfx_input.world_position.xyz;
	float eye_z = -mul(vec4(wp, 1.0), view_from_world).z;

	// The UI model tile's cell clip (`anim_slots.w`): a mat-anim row holding the cell in atlas
	// texels, top-down; GL's fragment rows count bottom-up, but for a target drawn top-down
	// (`misc.y` 2).
	if (anim_slots.w > 0.5)
	{
		vec4 r = light_row(WOW_MATANIM_BASE + int(anim_slots.w));
		vec2 px = gfx_input.gfx_position.xy;
		if (misc.y > 0.5 && misc.y < 1.5)
			px.y = misc.z - px.y;
		if (px.x < r.x || px.y < r.y || px.x > r.z || px.y > r.w)
			discard;
	}
	// The far-clip wall: discard past `farclip` (`fog_params.w`, 0 = off) by planar eye depth.
	vec4 fog_params = light_row(5);
	if (fog_params.w > 0.0 && eye_z > fog_params.w)
		discard;
	// The straddle split (`WOW_WATER_CLIP`): each copy of a translucent model crossing its water
	// plane keeps its half.
	if (flags.x > 0.5)
	{
		int slot = int((tag.x >> 19u) & 0x7ffu);
		vec4 pair = light_row(WOW_WATER_CLIP_BASE + (slot >> 1));
		vec2 water_clip = (slot & 1) == 0 ? pair.xy : pair.zw;
		if (water_clip.y != 0.0)
		{
			bool far_copy = (markers & 2048u) != 0u;
			float keep_side = far_copy ? -water_clip.y : water_clip.y;
			if (keep_side * (wp.y - water_clip.x) < 0.0)
				discard;
		}
	}
	// The M2 texture transform (`tex_anim::uv_transform`): uv' = R((uv + t - p) s) + p; an
	// env-mapped coordinate takes none.
	vec2 uv = gfx_input.uv;
	if ((markers & 4096u) == 0u)
	{
		vec2 uv_t = uv + sun_scale.zw + light_row(WOW_MATANIM_BASE + int(anim_slots.x)).xy;
		vec4 affine = light_row(WOW_MATANIM_BASE + int(anim_slots.z));
		vec2 d = (uv_t - vec2(0.5, 0.5)) * vec2(1.0 + affine.z, 1.0 + affine.w);
		float c = 1.0 + affine.x;
		uv = vec2(0.5 + d.x * c - d.y * affine.y, 0.5 + d.x * affine.y + d.y * c);
	}
	// `pbr_input_from_standard_material`: the StandardMaterial UV transform, then the texel.
	vec2 suv = vec2(uv_matrix.x * uv.x + uv_matrix.z * uv.y, uv_matrix.y * uv.x + uv_matrix.w * uv.y) + uv_offset_cutoff_mode.xy;
	float mip_bias = misc.x;
	vec4 vcolor = gfx_input.color;
	vec4 base_c = base_color * vcolor * sample_bias(suv, mip_bias);
	// WMO MOCV alpha is lighting data: the output alpha is the texel's alone. This and the clutter
	// sample read the untransformed UV, as the WGSL's own samples do.
	if (has_colors && model_flags.x > 0.5)
		base_c.a = sample_bias(uv, mip_bias).a;
	// The detail-doodad LOD bias, on the clutter sample.
	if (clutter_fade.w > 0.5)
		base_c = sample_bias(uv, mip_bias + DETAIL_DOODAD_LOD_BIAS) * vcolor;
	// The clutter distance fade, the reference's stage-1 ramp by camera-space depth.
	if (clutter_fade.w > 0.5)
	{
		float u = (eye_z - clutter_fade.x) / max(clutter_fade.y - clutter_fade.x, 0.001);
		float ramp = clamp((254.0 - 256.0 * u) / 255.0, 0.0, 252.0 / 255.0);
		base_c.a = base_c.a * ramp;
	}

	// The MeshTag: bit 31 highlight, bit 30 interior fog; payload bits 0-5 the fade alpha (zero is
	// opaque), 19-29 the rig slot, 6-13 the ground shade or, on an interior prop, 6-18 the probe.
	bool interior_prop = model_flags.z > 0.5 && model_flags.x < 0.5;
	uint raw_tag = tag.x;
	bool highlighted = (raw_tag & 0x80000000u) != 0u;
	bool interior_fogged = (raw_tag & 0x40000000u) != 0u;
	uint fade_tag = raw_tag & 0x3fffffffu;
	float alpha6 = float(fade_tag & 0x3fu) / 63.0;
	float obj_fade = fade_tag == 0u ? 1.0 : alpha6;
	if (merged_fade_on)
		obj_fade = obj_fade * gfx_input.merged_fade;
	// The body tint by rig slot (`rig_tint`, packed as rgb24 floats with -1 = identity).
	int rig_slot = int((fade_tag >> 19u) & 0x7ffu);
	vec4 tint_row = light_row(WOW_RIG_TINT_BASE + (rig_slot >> 2));
	int tint_lane = rig_slot & 3;
	float tint_word = tint_lane == 0 ? tint_row.x : (tint_lane == 1 ? tint_row.y : (tint_lane == 2 ? tint_row.z : tint_row.w));
	vec3 inst_tint = vec3(1.0, 1.0, 1.0);
	if (tint_word >= 0.0)
	{
		uint word = uint(tint_word);
		inst_tint = vec3(float((word >> 16u) & 0xffu), float((word >> 8u) & 0xffu), float(word & 0xffu)) * (1.0 / 255.0);
	}
	// The blend twin re-applies its source's cutout (bit 10).
	if ((markers & 1024u) != 0u && base_c.a < VANILLA_ALPHA_KEY)
		discard;
	float faded_alpha = base_c.a * obj_fade;
	// `alpha_discard`: opaque pins alpha to 1, a mask cuts below its cutoff.
	vec4 base = base_c;
	float alpha_mode = uv_offset_cutoff_mode.w;
	if (alpha_mode < 0.5)
	{
		base.a = 1.0;
	}
	else if (alpha_mode < 1.5)
	{
		if (base.a < uv_offset_cutoff_mode.z)
			discard;
		base.a = 1.0;
	}

	// --- Lighting ---------------------------------------------------------------------------
	vec4 light_ambient = light_row(0);
	vec4 light_diffuse = light_row(1);
	vec4 light_sun = light_row(2);
	vec4 grade = light_row(17);
	bool is_clutter = clutter_fade.w > 0.5;
	vec3 L = -normalize(light_sun.xyz);
	vec3 n_lit = wow_normalize(gfx_input.world_normal);
	float ndotl = max(dot(n_lit, L), 0.0);
	vec3 lit_nl = clamp01(light_ambient.rgb + light_diffuse.rgb * ndotl);
	vec4 quad = vec4(n_lit.x * n_lit.y, n_lit.y * n_lit.z, n_lit.z * n_lit.z, n_lit.x * n_lit.z);
	vec4 n1 = vec4(n_lit, 1.0);
	float x2y2 = n_lit.x * n_lit.x - n_lit.y * n_lit.y;
	// The `Model2.bls` lobe at the per-instance intensity (see the WGSL for the families and the
	// `min(I, 1)` deviation).
	float inst_shade = interior_prop ? 0.0 : float((fade_tag >> 6u) & 0xffu) / 255.0;
	float mat_shade = sun_scale.x < 0.5 ? 1.0 : 0.0;
	float shade_t = max(mat_shade, inst_shade);
	bool mid_band = sun_scale.x >= 0.5 && sun_scale.x < 0.85;
	float intensity = min(mid_band ? 1.0 : mix(2.5, 0.5, shade_t), 1.0);
	vec3 sun_dc = grade.yzw * intensity;
	vec4 sh_c10_r = light_row(6);
	vec4 sh_c10_g = light_row(7);
	vec4 sh_c10_b = light_row(8);
	vec4 sh_c16 = light_row(12);
	vec3 sun_lobe = vec3(
		sh_c10_r.w + sun_dc.x + intensity * (dot(sh_c10_r.xyz, n_lit) + dot(light_row(9), quad) + sh_c16.x * x2y2),
		sh_c10_g.w + sun_dc.y + intensity * (dot(sh_c10_g.xyz, n_lit) + dot(light_row(10), quad) + sh_c16.y * x2y2),
		sh_c10_b.w + sun_dc.z + intensity * (dot(sh_c10_b.xyz, n_lit) + dot(light_row(11), quad) + sh_c16.z * x2y2));
	vec3 lit_doodad = clamp01(sun_lobe);
	bool is_wmo = model_flags.x > 0.5;
	bool is_interior = model_flags.z > 0.5;
	bool use_doodad_shade = light_sun.w > 0.5 && !is_clutter && !is_wmo;
	vec3 lit_exterior = use_doodad_shade ? lit_doodad : lit_nl;
	// WMO interior groups by batch class (`tint.w`): INT unlit, TRANS the lit/unlit lerp by
	// MOCV.a, EXT `lit_nl`; a WINDOW batch lights at the Direct/Ambient midpoint.
	float trans_a = has_colors ? vcolor.a : 1.0;
	vec3 window_mid = 0.5 * (light_ambient.rgb + light_diffuse.rgb);
	vec3 lit_window = clamp01(window_mid + vec3(16.0 / 255.0, 16.0 / 255.0, 16.0 / 255.0) + window_mid * ndotl);
	vec3 lit_int_base = sidn.w > 0.5 ? lit_window : lit_nl;
	vec3 lit_wmo_interior = vec3(1.0, 1.0, 1.0);
	if (tint.w > 1.5)
		lit_wmo_interior = mix(vec3(1.0, 1.0, 1.0), lit_int_base, trans_a);
	else if (tint.w < 0.5)
		lit_wmo_interior = lit_int_base;
	// Interior M2 props: the prop's order-2 SH probe (7 rows a slot).
	int probe = WOW_PROBES_BASE + 7 * (merged_slot_on ? gfx_input.merged_slot : int((fade_tag >> 6u) & 0x1fffu));
	vec4 p3 = light_row(probe + 3);
	vec4 p4 = light_row(probe + 4);
	vec4 p5 = light_row(probe + 5);
	vec4 p6 = light_row(probe + 6);
	vec3 lit_m2_interior = clamp01(vec3(
		dot(light_row(probe), n1) + dot(p3, quad) + p6.x * x2y2,
		dot(light_row(probe + 1), n1) + dot(p4, quad) + p6.y * x2y2,
		dot(light_row(probe + 2), n1) + dot(p5, quad) + p6.z * x2y2));
	vec3 lit_interior = is_wmo ? lit_wmo_interior : lit_m2_interior;
	bool is_rig = sun_scale.x >= 1.5;
	vec3 lit = is_rig ? lit_m2_interior : (is_interior ? lit_interior : lit_exterior);
	// Gamma-space albedo, times the animated M2Color tint.
	vec3 anim_tint = tint.rgb + light_row(WOW_MATANIM_BASE + int(anim_slots.y)).xyz;
	vec3 albedo = base.rgb * anim_tint;
	bool is_emissive = model_flags.w > 0.5;
	// SIDN night glow, on lit lanes only.
	float sidn_w = 1.0;
	if (is_interior && is_wmo)
	{
		if (tint.w > 1.5)
			sidn_w = trans_a;
		else if (tint.w > 0.5)
			sidn_w = 0.0;
	}
	vec3 sidn_e = sidn.rgb * (grade.x * sidn_w);
	vec3 point_diffuse = gfx_input.point_lit;
	// The hover/target highlight: the scene ambient, inside the final clamp.
	vec3 highlight = highlighted ? light_ambient.rgb : vec3(0.0, 0.0, 0.0);
	// The FFP combine `tex x clamp(C sum + emission)`, C = MOCV on WMO, the body tint on M2.
	vec3 lit_rgb;
	if (has_colors && is_wmo)
	{
		vec3 vc = vcolor.rgb;
		vec3 primary = clamp01(vc * (lit + point_diffuse) + sidn_e + highlight);
		vec3 tex_rgb = base.rgb / max(vc, vec3(1.0 / 255.0, 1.0 / 255.0, 1.0 / 255.0));
		lit_rgb = tex_rgb * tint.rgb * primary;
		if (is_interior && tint.w > 0.5 && tint.w < 1.5)
			lit_rgb = clamp01(tex_rgb * tint.rgb * vc * (1.0 + 4.0 * trans_a));
	}
	else
	{
		vec3 primary = clamp01(inst_tint * (lit + point_diffuse) + sidn_e + highlight);
		lit_rgb = albedo * primary;
	}
	// The unlit path: an M2 modulates `clamp(C tint + highlight)`; a WMO the plain modulate.
	vec3 unlit_rgb = albedo * inst_tint;
	if (!is_wmo)
	{
		vec3 unlit_c = anim_tint;
		vec3 unlit_tex = base.rgb;
		if (has_colors)
		{
			unlit_c = vcolor.rgb * anim_tint;
			unlit_tex = base.rgb / max(vcolor.rgb, vec3(1.0 / 255.0, 1.0 / 255.0, 1.0 / 255.0));
		}
		unlit_rgb = unlit_tex * clamp01(unlit_c * inst_tint + highlight);
	}
	vec3 rgb = is_emissive ? unlit_rgb : lit_rgb;
	// An M2 Mod or Mod2x batch draws the bare texel.
	bool is_mod = (markers & 128u) != 0u;
	bool is_mod2x = (markers & 256u) != 0u;
	if ((is_mod || is_mod2x) && !is_wmo)
		rgb = base.rgb;

	// Linear fog by planar eye depth, per-batch colour policy (bits 4-6): 0 scene, 1 black,
	// 2 white, 3 grey, 4 unfogged; tag bit 30 selects the interior triple.
	vec4 fog_color = light_row(4);
	vec2 fog_span = fog_params.xy;
	if (interior_fogged)
	{
		fog_color = light_row(18);
		fog_span = light_row(19).xy;
	}
	uint fog_policy = (markers >> 4u) & 7u;
	if (fog_color.w > 0.5 && fog_policy != 4u)
	{
		float denom = max(fog_span.y - fog_span.x, 0.001);
		float factor = clamp((fog_span.y - eye_z) / denom, 0.0, 1.0);
		vec3 fog_rgb = fog_color.xyz;
		if (fog_policy == 1u)
			fog_rgb = vec3(0.0, 0.0, 0.0);
		else if (fog_policy == 2u)
			fog_rgb = vec3(1.0, 1.0, 1.0);
		else if (fog_policy == 3u)
			fog_rgb = vec3(0.50196078, 0.50196078, 0.50196078);
		rgb = mix(fog_rgb, rgb, factor);
	}

	// Output alpha is tex x fade; opaque intent (bit 3) pins it to 1. Additive (bit 2) weights
	// the colour by alpha in gamma; Mod/Mod2x fade toward the blend identity.
	bool opaque_intent = (markers & 8u) != 0u;
	bool is_additive = (markers & 4u) != 0u;
	vec3 out_rgb = rgb;
	if (is_additive)
		out_rgb = out_rgb * faded_alpha;
	if (is_mod || is_mod2x)
	{
		vec3 identity = is_mod2x ? vec3(0.5, 0.5, 0.5) : vec3(1.0, 1.0, 1.0);
		out_rgb = mix(identity, out_rgb, obj_fade);
	}
	// Raw gamma out, decoded once in the FFXGlow combine.
	gfx_output.color = vec4(out_rgb, opaque_intent ? 1.0 : faded_alpha);
	return gfx_output;
}
